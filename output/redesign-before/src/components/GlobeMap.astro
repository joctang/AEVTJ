---
// Globo 3D (cobe) con España y los países de las asociaciones aliadas,
// como animación complementaria al mapa plano de WorldMap.astro.
// Puerto a JS vanilla (sin React) para no añadir @astrojs/react al proyecto.
import { worldPartners } from "../data/partners";

const countryLocations: Record<string, [number, number]> = {
  es: [40.4637, -3.7492],
  ar: [-38.4161, -63.6167],
  mx: [23.6345, -102.5528],
  gb: [55.3781, -3.436],
  cz: [49.8175, 15.473],
  de: [51.1657, 10.4515],
  nl: [52.1326, 5.2913],
  us: [37.0902, -95.7129],
  au: [-25.2744, 133.7751],
};

const countryNames: Record<string, string> = {
  es: "España",
  ar: "Argentina",
  mx: "México",
  gb: "Reino Unido",
  cz: "República Checa",
  de: "Alemania",
  nl: "Países Bajos",
  us: "Estados Unidos",
  au: "Australia",
};

const partnerCountries = [...new Set(worldPartners.map((p) => p.country).filter((c): c is string => Boolean(c)))];

const markers = [
  { id: "es", location: countryLocations.es, label: "España · 815 socios" },
  ...partnerCountries
    .filter((c) => c !== "es" && countryLocations[c])
    .map((c) => ({ id: c, location: countryLocations[c], label: countryNames[c] ?? c })),
];

const arcs = markers
  .filter((m) => m.id !== "es")
  .map((m) => ({ id: `es-${m.id}`, from: countryLocations.es, to: m.location }));
---

<div class="globe-map mx-auto w-full max-w-lg">
  <div class="globe-canvas-wrap">
    <canvas id="globe-canvas"></canvas>
  </div>
  <div class="globe-label mt-4 min-h-[2.75rem] text-center">
    <p class="default-label font-heading text-sm uppercase tracking-widest text-brand-ink/60">
      Arrastra el globo para explorar
    </p>
  </div>
</div>

<style>
  .globe-canvas-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
  }

  #globe-canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
    opacity: 0;
    transition: opacity 1.2s ease;
    touch-action: none;
  }

  .globe-label {
    font-size: 0.82rem;
  }

  .globe-label .active-label {
    color: var(--color-brand-olive);
  }
</style>

<script define:vars={{ markers, arcs }} is:inline>
  window.__globeData = { markers, arcs };
</script>

<script>
  import createGlobe from "cobe";

  const { markers, arcs } = window.__globeData;
  const wrap = document.querySelector(".globe-map");
  const canvas = document.getElementById("globe-canvas");
  const label = wrap?.querySelector(".globe-label");
  const defaultHTML = label?.innerHTML ?? "";
  const markerById = Object.fromEntries(markers.map((m) => [m.id, m]));

  let cleanup = () => {};

  function init() {
    if (!canvas) return;

    let phi = 0;
    let width = 0;
    const pointerInteracting = { current: null };
    const pointerInteractionMovement = { current: 0 };
    let lastPointer = null;
    let velocity = 0;
    let paused = false;
    let animationId;

    const onResize = () => {
      width = canvas.offsetWidth;
    };
    window.addEventListener("resize", onResize);
    onResize();

    const globe = createGlobe(canvas, {
      devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
      width: width * 2,
      height: width * 2,
      phi: 0,
      theta: 0.28,
      dark: 0,
      diffuse: 1.5,
      mapSamples: 16000,
      mapBrightness: 9,
      baseColor: [0.96, 0.94, 0.9],
      markerColor: [0.357, 0.412, 0.204],
      glowColor: [0.96, 0.94, 0.9],
      markerElevation: 0.01,
      markers: markers.map((m) => ({ location: m.location, size: 0.05, id: m.id })),
      arcs: arcs.map((a) => ({ from: a.from, to: a.to, id: a.id })),
      arcColor: [0.357, 0.412, 0.204],
      arcWidth: 1.2,
      arcHeight: 0.35,
      opacity: 0.85,
      onRender: (state) => {
        if (!paused) {
          phi += 0.003;
        }
        state.phi = phi + pointerInteractionMovement.current;
        state.width = width * 2;
        state.height = width * 2;
      },
    });

    const showLabel = (id) => {
      if (!label) return;
      const m = markerById[id];
      if (!m) return;
      label.innerHTML = `<p class="active-label font-heading text-sm uppercase tracking-widest">${m.label}</p>`;
    };
    const hideLabel = () => {
      if (label) label.innerHTML = defaultHTML;
    };

    let cycleIndex = 0;
    const cycleId = setInterval(() => {
      if (paused) return;
      cycleIndex = (cycleIndex + 1) % markers.length;
      showLabel(markers[cycleIndex].id);
    }, 2600);
    if (markers.length) showLabel(markers[0].id);

    const onPointerDown = (e) => {
      pointerInteracting.current = e.clientX - pointerInteractionMovement.current;
      lastPointer = { x: e.clientX, t: Date.now() };
      canvas.style.cursor = "grabbing";
      paused = true;
      hideLabel();
    };
    const onPointerUp = () => {
      pointerInteracting.current = null;
      canvas.style.cursor = "grab";
      paused = false;
      lastPointer = null;
    };
    const onPointerMove = (e) => {
      if (pointerInteracting.current === null) return;
      const delta = e.clientX - pointerInteracting.current;
      pointerInteractionMovement.current = delta;
      const now = Date.now();
      if (lastPointer) {
        const dt = Math.max(now - lastPointer.t, 1);
        velocity = Math.max(-0.08, Math.min(0.08, ((e.clientX - lastPointer.x) / dt) * 0.15));
      }
      lastPointer = { x: e.clientX, t: now };
    };

    canvas.addEventListener("pointerdown", onPointerDown);
    window.addEventListener("pointermove", onPointerMove);
    window.addEventListener("pointerup", onPointerUp);

    setTimeout(() => (canvas.style.opacity = "1"));

    cleanup = () => {
      clearInterval(cycleId);
      window.removeEventListener("resize", onResize);
      canvas.removeEventListener("pointerdown", onPointerDown);
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("pointerup", onPointerUp);
      globe.destroy();
    };
  }

  init();

  document.addEventListener("astro:before-swap", () => cleanup(), { once: true });
</script>
