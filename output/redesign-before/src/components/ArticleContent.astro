---
import TornEdge from "./TornEdge.astro";

interface Props {
  title: string;
  date?: string;
  image?: string | null;
  heroPhoto?: string;
  html: string;
}
const { title, date, image, heroPhoto, html } = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString("es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;
---

<article>
  {
    heroPhoto ? (
      <header class="relative overflow-hidden bg-brand-ink text-white">
        <img src={heroPhoto} alt="" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-brand-ink/70" />
        <div class="relative mx-auto max-w-[900px] px-5 py-20 text-center lg:px-8 lg:py-28">
          <h1 class="font-heading text-4xl font-semibold uppercase tracking-wide sm:text-5xl">
            {title}
          </h1>
          <div class="mx-auto mt-3 h-1 w-24 bg-brand-olive" />
        </div>
        <TornEdge />
      </header>
    ) : (
      <header class="border-b border-black/5 bg-brand-cream">
        <div class="mx-auto max-w-[900px] px-5 py-14 text-center lg:px-8">
          {formattedDate && (
            <p class="mb-2 font-heading text-sm uppercase tracking-widest text-brand-olive">
              {formattedDate}
            </p>
          )}
          <h1 class="font-heading text-4xl font-semibold uppercase tracking-wide text-brand-ink sm:text-5xl">
            {title}
          </h1>
        </div>
      </header>
    )
  }

  {
    image && (
      <div class="mx-auto -mt-8 max-w-[900px] px-5 lg:px-8">
        <img
          src={image}
          alt={title}
          class="aspect-[16/9] w-full rounded-lg object-cover shadow-lg"
        />
      </div>
    )
  }

  <div class="mx-auto max-w-[820px] px-5 py-12 lg:px-8">
    <div class="prose prose-lg max-w-none prose-headings:font-heading prose-img:rounded-lg" set:html={html} />
  </div>
</article>
