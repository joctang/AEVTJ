---
import BaseLayout from "../layouts/BaseLayout.astro";
import TornEdge from "../components/TornEdge.astro";

const contacts = [
  {
    title: "Bienvenida o AYUDA",
    email: "info@victimasdetestigosdejehova.org",
  },
  {
    title: "Organismos, Institución y Periodistas",
    email: "medios@victimasdetestigosdejehova.org",
  },
  {
    title: "Secretaría",
    email: "secretaria@victimasdetestigosdejehova.org",
  },
];
---

<BaseLayout title="Contacto">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-ink text-white">
    <img
      src="/uploads/2025/10/ju-on-e6XsI7qqvAA-unsplash-1.jpg"
      alt="Bosque en penumbra"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-brand-ink/60"></div>
    <div class="relative mx-auto flex max-w-[1200px] flex-col gap-2 px-5 py-24 lg:flex-row lg:items-end lg:justify-between lg:px-8 lg:py-32">
      <div>
        <h1 class="font-heading text-6xl font-bold uppercase tracking-wide sm:text-7xl">Contacto</h1>
        <div class="mt-3 h-1 w-24 bg-brand-olive"></div>
      </div>
      <div class="text-white/90">
        <p>Queremos ayudarte.</p>
        <p>Puedes ayudar a que este movimiento sea imparable</p>
      </div>
    </div>
    <TornEdge />
  </section>

  <!-- Tienes mas preguntas -->
  <section class="mx-auto max-w-[820px] px-5 pt-16 text-center lg:px-8">
    <p class="font-heading text-sm uppercase tracking-widest text-brand-olive">¿Tienes mas</p>
    <h2 class="mt-1 font-heading text-5xl font-bold uppercase tracking-wide text-brand-ink sm:text-6xl">
      Preguntas?
    </h2>
    <p class="mt-3 text-brand-ink/70">Te responderemos lo antes posible</p>
  </section>

  <!-- Emails de contacto -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 lg:px-8">
    <h2 class="text-center font-heading text-3xl font-semibold uppercase tracking-wide text-brand-ink sm:text-4xl">
      Emails de contacto
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        contacts.map((c) => (
          <div class="rounded-xl border border-black/5 p-6 text-center shadow-sm">
            <h3 class="font-heading text-base font-bold uppercase text-brand-ink">{c.title}</h3>
            <a
              href={`mailto:${c.email}`}
              class="mt-3 inline-block text-sm text-brand-ink/75 hover:text-brand-olive"
            >
              {c.email}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Newsletter -->
  <section class="mx-auto max-w-[1200px] px-5 pb-16 lg:px-8">
    <div class="grid overflow-hidden rounded-xl shadow-lg sm:grid-cols-2">
      <div class="flex items-center bg-brand-olive p-8 sm:p-10">
        <h3 class="font-heading text-2xl font-semibold text-white sm:text-3xl">
          Apúntate a nuestra Newsletter
        </h3>
      </div>
      <div class="bg-brand-ink p-8 text-white sm:p-10">
        <form onsubmit="return false" class="flex flex-col gap-3">
          <label class="text-sm font-medium">
            Tu correo electrónico
            <input
              type="email"
              class="mt-1.5 w-full rounded-md border border-white/30 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/50 outline-none focus:border-white"
            />
          </label>
          <p class="text-xs text-white/70">
            Solo usaremos tu correo para enviarte la newsletter. Sin spam, sin cesión de
            datos a terceros.
          </p>
          <label class="flex items-start gap-2 text-xs text-white/70">
            <input type="checkbox" class="mt-0.5" />
            Acepto la <a href="/politica-de-privacidad/" class="underline">Política de Privacidad</a>
            y el tratamiento de mis datos con el fin de recibir la newsletter.
          </label>
          <button
            type="submit"
            class="mt-2 self-start rounded-md bg-brand-olive px-6 py-2.5 font-heading text-sm font-semibold uppercase tracking-wide text-white hover:bg-brand-olive-dark"
          >
            Quiero suscribirme
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
