---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../components/ArticleContent.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({
    params: { slug: p.data.slug },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { title, html, image, date } = entry.data;
---

<BaseLayout title={title}>
  <ArticleContent title={title} html={html} image={image} date={date} />
  <div class="mx-auto max-w-[820px] px-5 pb-16 lg:px-8">
    <a href="/noticias/" class="font-heading text-sm font-semibold uppercase tracking-wide text-brand-olive hover:text-brand-olive-dark">
      ← Volver a Noticias
    </a>
  </div>
</BaseLayout>
