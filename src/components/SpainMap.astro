---
// Mapa de España por comunidades autónomas (CC-BY-4.0, @svg-maps/spain),
// coropleta con los socios por comunidad según el mapa del WordPress original
// (plugin Interactive Geo Maps, post 3344).
import spain from "@svg-maps/spain";
import { membersByRegion } from "../data/members";

const nameEs: Record<string, string> = {
  andalusia: "Andalucía",
  aragon: "Aragón",
  asturias: "Asturias",
  "balearic-islands": "Islas Baleares",
  "basque-country": "País Vasco",
  "canary-islands": "Islas Canarias",
  cantabria: "Cantabria",
  "castile-and-leon": "Castilla y León",
  "castile-la-mancha": "Castilla-La Mancha",
  catalonia: "Cataluña",
  extremadura: "Extremadura",
  galicia: "Galicia",
  "la-rioja": "La Rioja",
  madrid: "Madrid",
  murcia: "Región de Murcia",
  navarre: "Navarra",
  valencia: "C. Valenciana",
};

const maxMembers = Math.max(...Object.values(membersByRegion));
const regions = spain.locations.map((loc) => {
  const members = membersByRegion[loc.id] ?? 0;
  const name = nameEs[loc.id] ?? loc.name;
  // Intensidad proporcional al número de socios (mín. 12 % para que se vea).
  const intensity = members > 0 ? 0.12 + 0.78 * (members / maxMembers) : 0;
  return { id: loc.id, path: loc.path, name, members, intensity };
});
---

<div class="spain-map mx-auto w-full max-w-lg">
  <svg
    viewBox={spain.viewBox}
    role="img"
    aria-label="Mapa de España con el número de socios por comunidad autónoma"
    class="h-auto w-full"
  >
    {
      regions.map((r) => (
        <path
          d={r.path}
          data-name={r.name}
          data-members={r.members}
          aria-label={`${r.name}: ${r.members} socios`}
          tabindex={r.members > 0 ? 0 : -1}
          class:list={["region cursor-pointer stroke-brand-cream [stroke-width:1.5] transition-[fill] duration-150", { "region-empty": r.members === 0 }]}
          style={`--tint:${r.intensity}`}
        />
      ))
    }
  </svg>
  <div class="region-label mt-3 min-h-[3.5rem] text-center" aria-live="polite">
    <p class="default-label text-sm text-brand-ink/80">Pasa el cursor por una comunidad para ver sus socios</p>
  </div>
</div>

<style>
  /* Coropleta: relleno verde oliva mezclado con blanco según --tint. */
  .spain-map .region {
    fill: color-mix(in srgb, var(--color-brand-olive) calc(var(--tint, 0) * 100%), #eef1e6);
  }
  .spain-map .region:hover,
  .spain-map .region:focus-visible {
    fill: var(--color-brand-olive-dark);
  }
</style>

<script>
  document.querySelectorAll<SVGPathElement>(".spain-map .region").forEach((el) => {
    const label = el.closest(".spain-map")?.querySelector(".region-label");
    const defaultHTML = label?.innerHTML ?? "";
    const show = () => {
      if (!label) return;
      const members = Number(el.dataset.members ?? 0);
      label.innerHTML = `
        <p class="font-heading text-sm uppercase tracking-widest text-brand-olive">${el.dataset.name}</p>
        <p class="mt-1 text-sm text-brand-ink">${members} ${members === 1 ? "socio" : "socios"}</p>
      `;
    };
    const hide = () => {
      if (label) label.innerHTML = defaultHTML;
    };
    el.addEventListener("mouseenter", show);
    el.addEventListener("focus", show);
    el.addEventListener("click", show);
    el.addEventListener("mouseleave", hide);
    el.addEventListener("blur", hide);
  });
</script>
