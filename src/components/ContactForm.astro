<div class="mx-auto max-w-[640px] px-5 pb-16 lg:px-8">
  <form onsubmit="return false" class="flex flex-col gap-4 rounded-xl border border-black/10 bg-brand-cream p-6 sm:p-8">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
        Nombre
        <input
          type="text"
          name="nombre"
          class="rounded-md border border-black/15 bg-white px-3 py-2 outline-none focus:border-brand-olive"
        />
      </label>
      <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
        Email
        <input
          type="email"
          name="email"
          class="rounded-md border border-black/15 bg-white px-3 py-2 outline-none focus:border-brand-olive"
        />
      </label>
    </div>
    <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
      Asunto
      <input
        type="text"
        name="asunto"
        class="rounded-md border border-black/15 bg-white px-3 py-2 outline-none focus:border-brand-olive"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
      Mensaje
      <textarea
        name="mensaje"
        rows="5"
        class="rounded-md border border-black/15 bg-white px-3 py-2 outline-none focus:border-brand-olive"
      ></textarea>
    </label>
    <button
      type="submit"
      class="mt-2 self-start rounded-md bg-brand-olive px-6 py-2.5 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-olive-dark"
    >
      Enviar mensaje
    </button>
  </form>
</div>
