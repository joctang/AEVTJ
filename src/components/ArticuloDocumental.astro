---
// Plantilla de los artículos documentales de /testigos-de-jehova/ (cumpleaños, Navidad…).
// Mismo lenguaje visual que /testigos-de-jehova/sangre/: hero navy, rail, índice numerado,
// insignias de capítulo, tarjetas de argumentos, línea de tiempo, «Texto original», FAQ y cierre.
// Los datos salen del borrador con `node scripts/articulo-desde-borrador.mjs <tema>`.
import "../styles/guia-salida.css";
import "../styles/sangre.css";
import "../styles/articulo-documental.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import TornEdge from "./TornEdge.astro";
import CitaTextual from "./CitaTextual.astro";

type Item = { etiqueta: string; html: string };
type Bloque =
  | { tipo: "parrafo"; html: string }
  | { tipo: "lista"; items: Item[] }
  | { tipo: "destacado"; html: string }
  | { tipo: "cita"; citas: string[]; fuente: string };
type Sub = { titulo: string; bloques: Bloque[] };
type Seccion = { id: string; titulo: string; bloques: Bloque[]; subsecciones: Sub[] };
type Ilustracion = { nombre: string; escena: string; alt: string; lista?: boolean; pos: "derecha" | "izquierda" };

interface Props {
  datos: { titulo: string; entrada: { tipo: string; html: string }[]; secciones: Seccion[]; preguntas?: { pregunta: string; respuesta: string }[] };
  slug: string;
  miga: string;
  tituloSeo?: string;
  descripcion: string;
  revisado: string;
  revisadoIso: string;
  cortos: Record<string, string>;
  hero?: { src: string; srcset?: string; alt: string; credito?: { texto: string; href: string } };
  accionHero: { texto: string; href: string };
  tarjetas?: string;
  linea?: string;
  casos?: string[];
  ilustraciones?: Record<string, Ilustracion>;
  sigueLeyendo: { titulo: string; descripcion: string; href: string }[];
}

const { datos, slug, miga, tituloSeo, descripcion, revisado, revisadoIso, cortos, hero, accionHero, tarjetas, linea, casos = [], ilustraciones = {}, sigueLeyendo } = Astro.props;

const secciones = datos.secciones;
const contenido = secciones.filter((s) => s.id !== "mirada-aevtj" && s.id !== "fuentes");
const mirada = secciones.find((s) => s.id === "mirada-aevtj");
const fuentes = secciones.find((s) => s.id === "fuentes");
const preguntas = datos.preguntas ?? [];

const textoPlano = (s: string) => s.replace(/<[^>]+>/g, "").replace(/&quot;/g, '"').replace(/&amp;/g, "&");
const todo = [
  ...datos.entrada.map((b) => b.html),
  ...secciones.flatMap((s) => [...s.bloques, ...s.subsecciones.flatMap((x) => x.bloques)])
    .flatMap((b) => (b.tipo === "parrafo" || b.tipo === "destacado" ? [b.html] : b.tipo === "lista" ? b.items.map((i) => i.html) : b.tipo === "cita" ? b.citas : [])),
];
const minutos = Math.max(1, Math.round(todo.map(textoPlano).join(" ").split(/\s+/).length / 200));
const etapa = (titulo: string) => {
  const i = titulo.indexOf(":");
  const t = i === -1 ? "" : titulo.slice(i + 1).trim();
  return { periodo: i === -1 ? titulo : titulo.slice(0, i), titulo: t && t.charAt(0).toUpperCase() + t.slice(1) };
};
const esCaso = (titulo: string) => casos.some((c) => titulo.startsWith(c));

const url = `${Astro.site ?? "https://victimasdetestigosdejehova.org/"}testigos-de-jehova/${slug}/`;
const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "Article", headline: datos.titulo, description: descripcion,
    author: { "@type": "Organization", name: "AEVTJ — Asociación Española de Víctimas de los Testigos de Jehová" },
    publisher: { "@type": "Organization", name: "AEVTJ" }, dateModified: revisadoIso, mainEntityOfPage: url,
  },
  ...(preguntas.length ? [{
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: preguntas.map((p) => ({ "@type": "Question", name: p.pregunta, acceptedAnswer: { "@type": "Answer", text: textoPlano(p.respuesta) } })),
  }] : []),
];
---

<BaseLayout title={tituloSeo ?? datos.titulo} description={descripcion} image={hero?.src} breadcrumbs={[{ label: "Testigos de Jehová", href: "/testigos-de-jehova/" }, { label: miga }]}>
  <div class="guia sg ad">
    <nav class="guia-rail" aria-label="Secciones de la página">
      <ol>
        {contenido.map((s, i) => <li><a href={`#${s.id}`}><span>{i + 1}. {cortos[s.id] ?? s.titulo}</span></a></li>)}
        {preguntas.length > 0 && <li><a href="#preguntas"><span>Preguntas frecuentes</span></a></li>}
        {mirada && <li><a href={`#${mirada.id}`}><span>La mirada de la AEVTJ</span></a></li>}
      </ol>
      <span class="guia-rail__progreso" aria-hidden="true"></span>
    </nav>

    <section class:list={["guia-hero sg-hero ad-hero", { "ad-hero--sinfoto": !hero }]}>
      {hero && <img class="guia-hero__img" src={hero.src} srcset={hero.srcset} sizes="70vw" alt={hero.alt} width="1536" height="1024" fetchpriority="high" decoding="async" />}
      <div class="guia-hero__scrim" aria-hidden="true"></div>
      <div class="guia-hero__content">
        <h1 class="sg-hero__titulo">{datos.titulo}</h1>
        <p class="guia-hero__entradilla" set:html={datos.entrada[0].html} />
        <div class="guia-hero__actions">
          <a class="guia-pill guia-pill--solid" href={accionHero.href}>{accionHero.texto}</a>
          {mirada && <a class="guia-pill guia-pill--ghost" href={`#${mirada.id}`}>Busco apoyo</a>}
        </div>
      </div>
      <div class="guia-hero__bottom">
        <ul class="guia-hero__meta" aria-label="Sobre esta página">
          <li><strong>{minutos}</strong> min de lectura</li>
          <li>Revisado el {revisado}</li>
          {hero?.credito && <li class="ad-credito">Foto: <a href={hero.credito.href} target="_blank" rel="noopener noreferrer">{hero.credito.texto}</a></li>}
        </ul>
        <a class="guia-hero__scroll" href="#ad-indice">Ver los temas <span aria-hidden="true">↓</span></a>
      </div>
      <TornEdge />
    </section>

    <section class="sg-indice" id="ad-indice" aria-labelledby="ad-indice-titulo">
      <div class="sg-ancho">
        {datos.entrada.slice(1).map((b) => <p class="sg-presentacion" data-reveal set:html={b.html} />)}
        <h2 id="ad-indice-titulo" class="sr-only">En esta página</h2>
        <ol class="sg-indice__lista">
          {contenido.map((s, i) => (
            <li data-reveal style={`transition-delay:${(i % 4) * 90}ms`}>
              <a href={`#${s.id}`}>
                <span class="sg-indice__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="sg-indice__titulo">{s.titulo}</span>
                <span class="sg-indice__ir" aria-hidden="true">↓</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {contenido.map((s, i) => {
      const ilus = ilustraciones[s.id];
      const nIntro = ilus ? s.bloques.findIndex((b) => b.tipo !== "parrafo") : 0;
      const intro = ilus ? s.bloques.slice(0, nIntro === -1 ? s.bloques.length : nIntro) : [];
      const resto = s.bloques.slice(intro.length);
      const pintar = (b: Bloque, enColumna = true) =>
        b.tipo === "parrafo" ? <p class:list={[{ "sg-columna": enColumna }, "sg-p"]} data-reveal set:html={b.html} />
        : b.tipo === "destacado" ? <p class:list={[{ "sg-columna": enColumna }, "sg-destacado"]} data-reveal set:html={b.html} />
        : b.tipo === "cita" ? <CitaTextual citas={b.citas} fuente={b.fuente} />
        : b.tipo === "lista" && s.id === tarjetas ? (
          <div class:list={["sg-ancho sg-versos ad-tarjetas", { "ad-tarjetas--4": b.items.length === 4 }]}>
            {b.items.map((item, j) => (
              <article class="sg-verso" data-reveal style={`transition-delay:${j * 120}ms`}>
                <span class="sg-verso__num" aria-hidden="true">{String(j + 1).padStart(2, "0")}</span>
                <h3 set:html={item.etiqueta.replace(/\.$/, "")} />
                <p set:html={item.html} />
              </article>
            ))}
          </div>
        )
        : b.tipo === "lista" ? (
          <ul class:list={[{ "sg-columna": enColumna }, "sg-lista sg-lista--claves ad-claves"]} data-reveal>
            {b.items.map((item) => <li>{item.etiqueta && <strong set:html={item.etiqueta} />} <Fragment set:html={item.html} /></li>)}
          </ul>
        ) : null;
      return (
        <section id={s.id} class:list={["sg-seccion", `ad-seccion--${s.id}`]} aria-labelledby={`${s.id}-titulo`}>
          {ilus ? (
            <div class={`sg-ancho sg-apertura sg-apertura--${ilus.pos}`}>
              <div class="sg-apertura__texto">
                <header class="sg-seccion__cabecera" data-reveal>
                  <div class="guia-badge" aria-hidden="true"><span>{i + 1}</span></div>
                  <h2 id={`${s.id}-titulo`}>{s.titulo}</h2>
                </header>
                {intro.map((b) => b.tipo === "parrafo" && <p class="sg-p" data-reveal set:html={b.html} />)}
              </div>
              <figure class="sg-apertura__img" data-reveal>
                {ilus.lista ? (
                  <img src={`/uploads/2026/10/${ilus.nombre}-1536.webp`} srcset={`/uploads/2026/10/${ilus.nombre}-900.webp 900w, /uploads/2026/10/${ilus.nombre}-1536.webp 1536w`} sizes="(max-width: 899px) 100vw, 46vw" width="1536" height="1024" alt={ilus.alt} loading="lazy" decoding="async" />
                ) : (
                  <span class="sg-hueco"><strong>Ilustración pendiente</strong>{ilus.escena}</span>
                )}
              </figure>
            </div>
          ) : (
            <header class="sg-columna sg-seccion__cabecera" data-reveal>
              <div class="guia-badge" aria-hidden="true"><span>{i + 1}</span></div>
              <h2 id={`${s.id}-titulo`}>{s.titulo}</h2>
            </header>
          )}

          {resto.map((b) => pintar(b))}

          {s.id === linea ? (
            <ol class="sg-columna sg-linea" data-linea>
              {s.subsecciones.map((sub, j) => {
                const e = etapa(sub.titulo);
                return (
                  <li class:list={["sg-etapa", { "sg-etapa--actual": j === s.subsecciones.length - 1 }]} data-reveal>
                    <span class="sg-etapa__periodo">{e.periodo}</span>
                    {e.titulo && <h3>{e.titulo}</h3>}
                    {sub.bloques.map((b) =>
                      b.tipo === "parrafo" ? <p set:html={b.html} />
                      : b.tipo === "cita" ? <CitaTextual citas={b.citas} fuente={b.fuente} />
                      : b.tipo === "destacado" ? <p class="sg-destacado ad-destacado--etapa" set:html={b.html} />
                      : null
                    )}
                  </li>
                );
              })}
            </ol>
          ) : (
            s.subsecciones.map((sub) => esCaso(sub.titulo) ? (
              <div class="sg-sub">
                <article class="sg-columna ad-caso" data-reveal>
                  <p class="ad-caso__etiqueta">Testimonio</p>
                  <h3>{sub.titulo}</h3>
                  {sub.bloques.map((b) => b.tipo === "parrafo" && <p set:html={b.html} />)}
                </article>
                {sub.bloques.filter((b) => b.tipo !== "parrafo").map((b) => pintar(b))}
              </div>
            ) : (
              <div class="sg-sub">
                <h3 class="sg-columna sg-sub__titulo" data-reveal>{sub.titulo}</h3>
                {sub.bloques.map((b) => pintar(b))}
              </div>
            ))
          )}
        </section>
      );
    })}

    {preguntas.length > 0 && (
      <section class="sg-faq" id="preguntas" aria-labelledby="ad-faq-titulo">
        <div class="sg-columna">
          <p class="guia-kicker" data-reveal>Dudas habituales</p>
          <h2 id="ad-faq-titulo" data-reveal>Preguntas frecuentes</h2>
          <div class="sg-faq__lista">
            {preguntas.map((p) => (
              <details class="sg-faq__item" data-reveal>
                <summary><h3>{p.pregunta}</h3><span class="sg-faq__signo" aria-hidden="true"></span></summary>
                <p set:html={p.respuesta} />
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {mirada && (
      <section class="guia-cierre" id={mirada.id} aria-labelledby="ad-mirada-titulo">
        <div class="guia-cierre__inner">
          <p class="guia-kicker guia-kicker--crema" data-reveal>La mirada de la AEVTJ</p>
          <h2 id="ad-mirada-titulo" class="sg-mirada__titulo" data-reveal>{mirada.titulo}</h2>
          <div class="sg-mirada__texto ad-mirada__texto">
            {mirada.bloques.map((b) => b.tipo === "parrafo" && <p data-reveal set:html={b.html} />)}
          </div>
          <p class="guia-kicker guia-kicker--crema sg-sigue" data-reveal>Sigue leyendo</p>
          <div class="guia-recursos">
            {sigueLeyendo.map((r) => (
              <a class="guia-recurso" href={r.href} data-reveal><h3>{r.titulo}</h3><p>{r.descripcion}</p></a>
            ))}
          </div>
          <div class="guia-cierre__actions" data-reveal>
            <a class="guia-pill guia-pill--solid" href="/contacto/">Contacta con la asociación</a>
            <a class="guia-pill guia-pill--ghost" href="/recursos-de-ayuda/">Recursos de ayuda</a>
          </div>
        </div>
      </section>
    )}

    {fuentes && (
      <section class="sg-columna ad-fuentes" aria-labelledby="ad-fuentes-titulo">
        <h2 id="ad-fuentes-titulo">{fuentes.titulo}</h2>
        {fuentes.bloques.map((b) =>
          b.tipo === "parrafo" ? <p set:html={b.html} />
          : b.tipo === "lista" ? <ul>{b.items.map((item) => <li>{item.etiqueta && <strong set:html={item.etiqueta} />} <Fragment set:html={item.html} /></li>)}</ul>
          : null
        )}
        <p class="ad-fuentes__fecha">Revisado el {revisado}. Los enlaces externos se abren en una pestaña nueva.</p>
      </section>
    )}
  </div>

  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

  <script>
    import { initRail } from "../scripts/rail";
    initRail(".guia-rail");

    // Línea de tiempo: se rellena con la lectura y marca las etapas ya recorridas.
    const linea = document.querySelector<HTMLElement>("[data-linea]");
    if (linea) {
      const etapas = [...linea.querySelectorAll<HTMLElement>(".sg-etapa")];
      let pendiente = false;
      const pintar = () => {
        pendiente = false;
        const caja = linea.getBoundingClientRect();
        const lectura = window.innerHeight * 0.55;
        linea.style.setProperty("--avance", String(Math.max(0, Math.min(1, (lectura - caja.top) / caja.height))));
        for (const e of etapas) e.classList.toggle("is-pasada", e.getBoundingClientRect().top < lectura);
      };
      const programar = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); } };
      window.addEventListener("scroll", programar, { passive: true });
      window.addEventListener("resize", programar);
      pintar();
    }
  </script>
</BaseLayout>
