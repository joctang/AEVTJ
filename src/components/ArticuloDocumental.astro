---
// Plantilla de los artículos documentales de /testigos-de-jehova/ (cumpleaños, Navidad…).
// Mismo lenguaje visual que /testigos-de-jehova/sangre/: hero navy, rail, índice numerado,
// insignias de capítulo, tarjetas de argumentos, línea de tiempo, «Texto original», FAQ y cierre.
// Los datos salen del borrador con `node scripts/articulo-desde-borrador.mjs <tema>`.
import "../styles/guia-salida.css";
import "../styles/sangre.css";
import "../styles/articulo-documental.css";
import TarjetaRelacionado from "./TarjetaRelacionado.astro";
import { miniaturaEnlaceRelacionado } from "../data/miniaturas-enlaces-relacionados";
import "../styles/referencias.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import TornEdge from "./TornEdge.astro";
import CitaTextual from "./CitaTextual.astro";
import ExperienciasAcordeon from "./ExperienciasAcordeon.astro";

type Item = { etiqueta: string; html: string };
type Bloque =
  | { tipo: "parrafo"; html: string }
  | { tipo: "lista"; items: Item[] }
  | { tipo: "destacado"; html: string }
  | { tipo: "cita"; citas: string[]; fuente: string }
  | { tipo: "tabla"; titulo?: string; cabecera: string[]; filas: string[][] };
type Sub = { titulo: string; bloques: Bloque[] };
type Seccion = { id: string; titulo: string; bloques: Bloque[]; subsecciones: Sub[] };
type Ilustracion = { nombre: string; escena: string; alt: string; lista?: boolean; pos: "derecha" | "izquierda" };
type GrupoIndice = { titulo: string; ids: string[] };

interface Props {
  datos: { titulo: string; entrada: { tipo: string; html: string }[]; secciones: Seccion[]; preguntas?: { pregunta: string; respuesta: string }[] };
  slug: string;
  miga: string;
  tituloSeo?: string;
  descripcion: string;
  revisado: string;
  revisadoIso: string;
  cortos: Record<string, string>;
  hero?: { src: string; srcset?: string; alt: string; credito?: { texto: string; href: string } };
  accionHero?: { texto: string; href: string };
  mostrarAccionesHero?: boolean;
  mostrarIntroIndice?: boolean;
  mostrarEtiquetaIndice?: boolean;
  indiceAcordeon?: boolean;
  tarjetas?: string;
  listaSimple?: string;
  linea?: string;
  casos?: string[];
  experiencias?: { seccion: string; datos: { etiquetas: any[]; grupos: any[]; casos: any[] } };
  ilustraciones?: Record<string, Ilustracion>;
  sigueLeyendo: { titulo: string; descripcion: string; href: string; imagen?: string }[];
  noindex?: boolean;
  referencias?: boolean;
  titulosFuentes?: Record<string, string>;
  notasFuentes?: Record<string, string>;
  gruposIndice?: GrupoIndice[];
}

const { datos: datosBase, slug, miga, tituloSeo, descripcion, revisado, revisadoIso, cortos, hero, accionHero, mostrarAccionesHero = true, mostrarIntroIndice = true, mostrarEtiquetaIndice = true, indiceAcordeon, tarjetas, listaSimple, linea, casos = [], experiencias, ilustraciones = {}, sigueLeyendo, noindex = false, referencias = false, titulosFuentes = {}, notasFuentes = {}, gruposIndice } = Astro.props;

// Bibliografía numerada (modo referencias): los enlaces externos del texto pasan a
// superíndices que remiten a una lista única de fuentes al final de la página.
// Los títulos de la bibliografía se curan en la página (titulosFuentes); los enlaces
// del bloque «fuentes» no se numeran: ahí van las obras de consulta adicional.
const numeradas = new Map<string, { n: number; url: string; titulo: string; nota?: string }>();
const esExterna = (href: string) => /^https?:\/\//i.test(href) && !href.includes("victimasdetestigosdejehova.org");
const numerar = (html: string): string => {
  if (!html.includes("<a ")) return html;
  return html.replace(/<a\s[^>]*?href="(https?:\/\/[^"]+)"[^>]*>([\s\S]*?)<\/a>/g, (m: string, href: string, texto: string) => {
    if (!esExterna(href)) return m;
    let r = numeradas.get(href);
    let primera = false;
    if (!r) {
      primera = true;
      r = {
        n: numeradas.size + 1,
        url: href,
        titulo: titulosFuentes[href] ?? texto.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim(),
        nota: notasFuentes[href],
      };
      numeradas.set(href, r);
    }
    return `${texto}<sup class="ad-ref"${primera ? ` id="ref-${r.n}"` : ""}><a href="#fn-${r.n}" aria-label="Fuente ${r.n}">${r.n}</a></sup>`;
  });
};
const numBloque = (b: Bloque): Bloque =>
  b.tipo === "parrafo" || b.tipo === "destacado" ? { ...b, html: numerar(b.html) }
  : b.tipo === "lista" ? { ...b, items: b.items.map((i) => ({ ...i, html: numerar(i.html) })) }
  : b.tipo === "tabla" ? { ...b, filas: b.filas.map((f) => f.map((c) => numerar(c))) }
  : b.tipo === "cita" ? { ...b, citas: b.citas.map((c) => numerar(c)), fuente: numerar(b.fuente) }
  : b;
const datos = referencias
  ? {
      ...datosBase,
      entrada: datosBase.entrada.map((b) => (b.tipo === "parrafo" ? { ...b, html: numerar(b.html) } : b)),
      secciones: datosBase.secciones.map((s) =>
        s.id === "fuentes"
          ? s
          : { ...s, bloques: s.bloques.map(numBloque), subsecciones: s.subsecciones.map((sub) => ({ ...sub, bloques: sub.bloques.map(numBloque) })) }
      ),
      preguntas: datosBase.preguntas?.map((p) => ({ ...p, respuesta: numerar(p.respuesta) })),
    }
  : datosBase;

const secciones = datos.secciones;
const contenido = secciones.filter((s) => s.id !== "mirada-aevtj" && s.id !== "fuentes");
const mirada = secciones.find((s) => s.id === "mirada-aevtj");
const fuentes = secciones.find((s) => s.id === "fuentes");
const preguntas = datos.preguntas ?? [];

// Si el texto no tiene citas numeradas (el cuerpo no enlaza, p. ej. Biblia), el
// acordeón cuenta los enlaces del propio bloque de fuentes.
const htmlsDe = (b: Bloque): string[] =>
  b.tipo === "cita" ? [...b.citas, b.fuente]
  : b.tipo === "tabla" ? b.filas.flat()
  : b.tipo === "lista" ? b.items.map((i) => `${i.etiqueta ?? ""} ${i.html}`)
  : [b.html ?? ""];
const enFuentes = new Set<string>();
if (referencias && numeradas.size === 0 && fuentes) {
  for (const b of fuentes.bloques) for (const h of htmlsDe(b)) {
    for (const m of h.matchAll(/href="(https?:\/\/[^"]+)"/g)) if (esExterna(m[1])) enFuentes.add(m[1]);
  }
}
const totalFuentes = numeradas.size || enFuentes.size;
const etiquetaFuentes = numeradas.size > 0 ? `${totalFuentes} referencias` : `${totalFuentes} fuentes`;

const textoPlano = (s: string) => s.replace(/<[^>]+>/g, "").replace(/&quot;/g, '"').replace(/&amp;/g, "&");
const todo = [
  ...datos.entrada.map((b) => b.html),
  ...secciones.flatMap((s) => [...s.bloques, ...s.subsecciones.flatMap((x) => x.bloques)])
    .flatMap((b) => (b.tipo === "parrafo" || b.tipo === "destacado" ? [b.html] : b.tipo === "lista" ? b.items.map((i) => i.html) : b.tipo === "cita" ? b.citas : b.tipo === "tabla" ? b.filas.flat() : [])),
];
const minutos = Math.max(1, Math.round(todo.map(textoPlano).join(" ").split(/\s+/).length / 200));
const etapa = (titulo: string) => {
  const i = titulo.indexOf(":");
  const t = i === -1 ? "" : titulo.slice(i + 1).trim();
  return { periodo: i === -1 ? titulo : titulo.slice(0, i), titulo: t && t.charAt(0).toUpperCase() + t.slice(1) };
};
// Con muchos temas el índice se pliega en un acordeón: el raíl lateral ya permite saltar entre secciones.
const indiceLargo = indiceAcordeon ?? contenido.length > 9;
const Caja = indiceLargo ? "details" : "div";
// Índice agrupado (acordeón): los grupos deben recorrer las secciones en el mismo orden y sin
// omitir ni repetir ninguna; si no, se ignora el agrupado y se pinta la lista plana de siempre.
const posiciones = new Map(contenido.map((s, i) => [s.id, i] as const));
const gruposValidos =
  indiceLargo && gruposIndice && gruposIndice.flatMap((g) => g.ids).join("|") === contenido.map((s) => s.id).join("|")
    ? gruposIndice
    : null;
const esCaso =(titulo: string) => casos.some((c) => titulo.startsWith(c));

const url = `${Astro.site ?? "https://victimasdetestigosdejehova.org/"}testigos-de-jehova/${slug}/`;
const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "Article", headline: datos.titulo, description: descripcion,
    author: { "@type": "Organization", name: "AEVTJ — Asociación Española de Víctimas de los Testigos de Jehová" },
    publisher: { "@type": "Organization", name: "AEVTJ" }, dateModified: revisadoIso, mainEntityOfPage: url,
  },
  ...(preguntas.length ? [{
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: preguntas.map((p) => ({ "@type": "Question", name: p.pregunta, acceptedAnswer: { "@type": "Answer", text: textoPlano(p.respuesta) } })),
  }] : []),
];
---

<BaseLayout title={tituloSeo ?? datos.titulo} description={descripcion} image={hero?.src} noindex={noindex} breadcrumbs={[{ label: "Testigos de Jehová", href: "/testigos-de-jehova/" }, { label: miga }]}>
  <div class:list={["guia", "sg", "ad", { "ad--biblia": slug === "biblia", "ad--fundador": slug === "fundador" }]}>
    <nav class="guia-rail" aria-label="Secciones de la página">
      <ol>
        {contenido.map((s, i) => <li><a href={`#${s.id}`}><span>{i + 1}. {cortos[s.id] ?? s.titulo}</span></a></li>)}
        {preguntas.length > 0 && <li><a href="#preguntas"><span>Preguntas frecuentes</span></a></li>}
        {fuentes && <li><a href="#fuentes"><span>Fuentes</span></a></li>}
        {mirada && <li><a href={`#${mirada.id}`}><span>La mirada de la AEVTJ</span></a></li>}
      </ol>
      <span class="guia-rail__progreso" aria-hidden="true"></span>
    </nav>

    <section class:list={["guia-hero sg-hero ad-hero", { "ad-hero--sinfoto": !hero, "ad-hero--biblia": slug === "biblia", "ad-hero--fundador": slug === "fundador", "ad-hero--vestimenta": slug === "vestimenta" }]}>
      {hero && <img class="guia-hero__img" src={hero.src} srcset={hero.srcset} sizes="70vw" alt={hero.alt} width={slug === "fundador" ? 1672 : 1536} height={slug === "fundador" ? 941 : 1024} fetchpriority="high" decoding="async" />}
      <div class="guia-hero__scrim" aria-hidden="true"></div>
      <div class="guia-hero__content">
        <h1 class="sg-hero__titulo">{datos.titulo}</h1>
        <p class="guia-hero__entradilla" set:html={datos.entrada[0].html} />
        {mostrarAccionesHero && accionHero && <div class="guia-hero__actions">
          <a class="guia-pill guia-pill--solid" href={accionHero.href}>{accionHero.texto}</a>
          {mirada && <a class="guia-pill guia-pill--ghost" href={`#${mirada.id}`}>Busco apoyo</a>}
        </div>}
      </div>
      <div class="guia-hero__bottom">
        <ul class="guia-hero__meta" aria-label="Sobre esta página">
          <li><strong>{minutos}</strong> min de lectura</li>
          <li>Revisado el {revisado}</li>
          {hero?.credito && <li class="ad-credito">Foto: <a href={hero.credito.href} target="_blank" rel="noopener noreferrer">{hero.credito.texto}</a></li>}
        </ul>
        <a class="guia-hero__scroll" href="#ad-indice">Ver los temas <span aria-hidden="true">↓</span></a>
      </div>
      <TornEdge />
    </section>

    <section class="sg-indice" id="ad-indice" aria-labelledby="ad-indice-titulo">
      <div class="sg-ancho">
        {mostrarIntroIndice && <>
          {mostrarEtiquetaIndice && <p class="guia-kicker" data-reveal>En esta página</p>}
          {datos.entrada.slice(1).map((b) => <p class="sg-presentacion" data-reveal set:html={b.html} />)}
        </>}
        <h2 id="ad-indice-titulo" class="sr-only">En esta página</h2>
        <Caja class={indiceLargo ? "ad-indice-acordeon" : undefined} data-reveal={indiceLargo ? "" : undefined}>
          {indiceLargo && <summary><span>Ver los {contenido.length} temas de esta página</span><span class="sg-faq__signo" aria-hidden="true"></span></summary>}
          <ol class:list={["sg-indice__lista", { "sg-indice__lista--tercios": contenido.length % 4 === 1 }]}>
            {gruposValidos
              ? gruposValidos.map((g) => (
                  <Fragment>
                    <li class="ad-indice__grupo">{g.titulo}</li>
                    {g.ids.map((id) => {
                      const i = posiciones.get(id) ?? 0;
                      const s = contenido[i];
                      return (
                        <li>
                          <a class="sg-indice__enlace" href={`#${s.id}`}>
                            <span class="sg-indice__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                            <span class="sg-indice__titulo">{s.titulo}</span>
                            <span class="sg-indice__ir" aria-hidden="true">↓</span>
                          </a>
                        </li>
                      );
                    })}
                  </Fragment>
                ))
              : contenido.map((s, i) => (
                  <li data-reveal={indiceLargo ? undefined : ""} style={indiceLargo ? undefined : `transition-delay:${(i % 4) * 90}ms`}>
                    <a class="sg-indice__enlace" href={`#${s.id}`}>
                      <span class="sg-indice__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                      <span class="sg-indice__titulo">{s.titulo}</span>
                      <span class="sg-indice__ir" aria-hidden="true">↓</span>
                    </a>
                  </li>
                ))}
          </ol>
        </Caja>
      </div>
    </section>

    {contenido.map((s, i) => {
      const ilus = ilustraciones[s.id];
      const nIntro = ilus ? s.bloques.findIndex((b) => b.tipo !== "parrafo") : 0;
      const intro = ilus ? s.bloques.slice(0, nIntro === -1 ? s.bloques.length : nIntro) : [];
      const resto = s.bloques.slice(intro.length);
      const pintar = (b: Bloque, enColumna = true) =>
        b.tipo === "parrafo" ? <p class:list={[{ "sg-columna": enColumna }, "sg-p"]} data-reveal set:html={b.html} />
        : b.tipo === "destacado" ? <p class:list={[{ "sg-columna": enColumna }, "sg-destacado"]} data-reveal set:html={b.html} />
        : b.tipo === "cita" ? <CitaTextual citas={b.citas} fuente={b.fuente} />
        : b.tipo === "tabla" ? (
          <div class="sg-ancho sg-tabla-wrap ad-tabla" data-reveal>
            <table class="sg-tabla">
              {b.titulo && <caption>{b.titulo}</caption>}
              <thead><tr>{b.cabecera.map((c) => <th scope="col" set:html={c} />)}</tr></thead>
              <tbody>
                {b.filas.map((f) => (
                  <tr>
                    {f.map((c, k) => (k === 0
                      ? <th scope="row"><span set:html={c} /></th>
                      : <td data-etiqueta={textoPlano(b.cabecera[k])} set:html={c} />))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
        : b.tipo === "lista" && s.id === listaSimple && b.items.length === 3 ? (
          <ul class:list={[{ "sg-columna": enColumna }, "sg-lista", "ad-lista-simple"]} data-reveal>
            {b.items.map((item) => <li>{item.etiqueta && <strong set:html={item.etiqueta} />} <Fragment set:html={item.html} /></li>)}
          </ul>
        )
        : b.tipo === "lista" && s.id === tarjetas ? (
          <div class:list={["sg-ancho sg-versos ad-tarjetas", { "ad-tarjetas--4": b.items.length === 4 }]}>
            {b.items.map((item, j) => (
              <article class="sg-verso" data-reveal style={`transition-delay:${j * 120}ms`}>
                <span class="sg-verso__num" aria-hidden="true">{String(j + 1).padStart(2, "0")}</span>
                <h3 set:html={item.etiqueta.replace(/\.$/, "")} />
                <p set:html={item.html} />
              </article>
            ))}
          </div>
        )
        : b.tipo === "lista" ? (
          <ul class:list={[{ "sg-columna": enColumna }, "sg-lista sg-lista--claves ad-claves"]} data-reveal>
            {b.items.map((item) => <li>{item.etiqueta && <strong set:html={item.etiqueta} />} <Fragment set:html={item.html} /></li>)}
          </ul>
        ) : null;
      return (
        <section id={s.id} class:list={["sg-seccion", `ad-seccion--${s.id}`]} aria-labelledby={`${s.id}-titulo`}>
          {ilus ? (
            <div class={`sg-ancho sg-apertura sg-apertura--${ilus.pos}`}>
              <div class="sg-apertura__texto">
                <header class="sg-seccion__cabecera" data-reveal>
                  <div class="guia-badge" aria-hidden="true"><span>{i + 1}</span></div>
                  <h2 id={`${s.id}-titulo`}>{s.titulo}</h2>
                </header>
                {intro.map((b) => b.tipo === "parrafo" && <p class="sg-p" data-reveal set:html={b.html} />)}
              </div>
              <figure class="sg-apertura__img" data-reveal>
                {ilus.lista ? (
                  <img src={`/uploads/2026/10/${ilus.nombre}-1536.webp`} srcset={`/uploads/2026/10/${ilus.nombre}-900.webp 900w, /uploads/2026/10/${ilus.nombre}-1536.webp 1536w`} sizes="(max-width: 899px) 100vw, 46vw" width="1536" height="1024" alt={ilus.alt} loading="lazy" decoding="async" />
                ) : (
                  <span class="sg-hueco"><strong>Ilustración pendiente</strong>{ilus.escena}</span>
                )}
              </figure>
            </div>
          ) : (
            <header class="sg-columna sg-seccion__cabecera" data-reveal>
              <div class="guia-badge" aria-hidden="true"><span>{i + 1}</span></div>
              <h2 id={`${s.id}-titulo`}>{s.titulo}</h2>
            </header>
          )}

          {resto.map((b) => pintar(b))}

          {experiencias && experiencias.seccion === s.id && (
            <ExperienciasAcordeon {...experiencias.datos}>
              {s.subsecciones.length > 0 && (
                <Fragment slot="intermedio">
                  {s.subsecciones.flatMap((sub) => sub.bloques).map((b) => pintar(b, false))}
                </Fragment>
              )}
            </ExperienciasAcordeon>
          )}

          {experiencias && experiencias.seccion === s.id ? null : s.id === linea ? (
            <ol class="sg-columna sg-linea" data-linea>
              {s.subsecciones.map((sub, j) => {
                const e = etapa(sub.titulo);
                return (
                  <li class:list={["sg-etapa", { "sg-etapa--actual": j === s.subsecciones.length - 1 }]} data-reveal>
                    <span class="sg-etapa__periodo">{e.periodo}</span>
                    {e.titulo && <h3>{e.titulo}</h3>}
                    {sub.bloques.map((b) =>
                      b.tipo === "parrafo" ? <p set:html={b.html} />
                      : b.tipo === "cita" ? <CitaTextual citas={b.citas} fuente={b.fuente} />
                      : b.tipo === "destacado" ? <p class="sg-destacado ad-destacado--etapa" set:html={b.html} />
                      : b.tipo === "lista" ? <ul class="ad-etapa-lista">{b.items.map((item) => <li>{item.etiqueta && <strong set:html={item.etiqueta} />} <Fragment set:html={item.html} /></li>)}</ul>
                      : null
                    )}
                  </li>
                );
              })}
            </ol>
          ) : (
            s.subsecciones.map((sub) => esCaso(sub.titulo) ? (
              <div class="sg-sub">
                <article class="sg-columna ad-caso" data-reveal>
                  <p class="ad-caso__etiqueta">Testimonio</p>
                  <h3>{sub.titulo}</h3>
                  {sub.bloques.map((b) => b.tipo === "parrafo" && <p set:html={b.html} />)}
                </article>
                {sub.bloques.filter((b) => b.tipo !== "parrafo").map((b) => pintar(b))}
              </div>
            ) : (
              <div class="sg-sub">
                <h3 class="sg-columna sg-sub__titulo" data-reveal>{sub.titulo}</h3>
                {sub.bloques.map((b) => pintar(b))}
              </div>
            ))
          )}
        </section>
      );
    })}

    {preguntas.length > 0 && (
      <section class="sg-faq" id="preguntas" aria-labelledby="ad-faq-titulo">
        <div class="sg-columna">
          <p class="guia-kicker" data-reveal>Dudas habituales</p>
          <h2 id="ad-faq-titulo" data-reveal>Preguntas frecuentes</h2>
          <div class="sg-faq__lista">
            {preguntas.map((p) => (
              <details class="sg-faq__item" data-reveal>
                <summary><h3>{p.pregunta}</h3><span class="sg-faq__signo" aria-hidden="true"></span></summary>
                <p set:html={p.respuesta} />
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {referencias && fuentes && (
      <section class="sg-columna ad-biblio-wrap" aria-labelledby="ad-fuentes-titulo">
        <details class="ad-biblio" id="fuentes">
          <summary>
            <span>
              <h2 id="ad-fuentes-titulo">Fuentes y documentación</h2>
              <span class="ad-biblio__cuenta">{etiquetaFuentes} · Revisado el {revisado}</span>
            </span>
            <span class="sg-faq__signo" aria-hidden="true"></span>
          </summary>
          <div class="ad-biblio__cuerpo">
            {fuentes.bloques[0]?.tipo === "parrafo" && <p set:html={fuentes.bloques[0].html} />}
            {numeradas.size > 0 && (
              <ol class="ad-biblio__lista">
                {[...numeradas.values()].map((r) => (
                  <li id={`fn-${r.n}`}>
                    <span class="ad-biblio__num" aria-hidden="true">{r.n}</span>
                    <span class="ad-biblio__entrada">
                      <a href={r.url} target="_blank" rel="noopener noreferrer">{r.titulo}</a>
                      {r.nota && <span class="ad-biblio__nota"> — {r.nota}</span>}
                    </span>
                    <a class="ad-biblio__volver" href={`#ref-${r.n}`} aria-label={`Volver al punto del texto que cita la fuente ${r.n}`}>↩</a>
                  </li>
                ))}
              </ol>
            )}
            {fuentes.bloques.slice(1).map((b) =>
              b.tipo === "parrafo" ? <p set:html={b.html} />
              : b.tipo === "lista" ? <ul>{b.items.map((item) => <li>{item.etiqueta && <strong set:html={item.etiqueta} />} <Fragment set:html={item.html} /></li>)}</ul>
              : null
            )}
            <p class="ad-fuentes__fecha">Los enlaces externos se abren en una pestaña nueva.</p>
          </div>
        </details>
      </section>
    )}

    {mirada && (
      <section class="guia-cierre" id={mirada.id} aria-labelledby="ad-mirada-titulo">
        <div class="guia-cierre__inner">
          <p class="guia-kicker guia-kicker--crema" data-reveal>La mirada de la AEVTJ</p>
          <h2 id="ad-mirada-titulo" class="sg-mirada__titulo" data-reveal>{mirada.titulo}</h2>
          <div class="sg-mirada__texto ad-mirada__texto">
            {mirada.bloques.map((b) => b.tipo === "parrafo" && <p data-reveal set:html={b.html} />)}
          </div>
          <p class="guia-kicker guia-kicker--crema sg-sigue" data-reveal>Sigue leyendo</p>
          <div class:list={["guia-recursos", { "guia-recursos--ilustrados": sigueLeyendo.some((r) => r.imagen || miniaturaEnlaceRelacionado(r.href)) }]}>
            {sigueLeyendo.map((r) => (
              <TarjetaRelacionado {...r} />
            ))}
          </div>
          <div class="guia-cierre__actions" data-reveal>
            <a class="guia-pill guia-pill--solid" href="/contacto/">Contacta con la asociación</a>
            <a class="guia-pill guia-pill--ghost" href="/recursos-de-ayuda/">Recursos de ayuda</a>
          </div>
        </div>
      </section>
    )}

    {fuentes && !referencias && (
      <section class="sg-columna ad-fuentes" id="fuentes" aria-labelledby="ad-fuentes-titulo">
        <h2 id="ad-fuentes-titulo">{fuentes.titulo}</h2>
        {fuentes.bloques.map((b) =>
          b.tipo === "parrafo" ? <p set:html={b.html} />
          : b.tipo === "lista" ? <ul>{b.items.map((item) => <li>{item.etiqueta && <strong set:html={item.etiqueta} />} <Fragment set:html={item.html} /></li>)}</ul>
          : null
        )}
        <p class="ad-fuentes__fecha">Revisado el {revisado}. Los enlaces externos se abren en una pestaña nueva.</p>
      </section>
    )}
  </div>

  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

  <script>
    import { initRail } from "../scripts/rail";
    initRail(".guia-rail");

    // Al pulsar un superíndice, despliega la bibliografía antes de saltar a la nota.
    document.addEventListener("click", (ev) => {
      const enlace = (ev.target as HTMLElement | null)?.closest?.("a");
      if (!enlace || !enlace.getAttribute("href")?.startsWith("#fn-")) return;
      const biblio = document.getElementById("fuentes");
      if (biblio instanceof HTMLDetailsElement && !biblio.open) biblio.open = true;
    });

    // Línea de tiempo: se rellena con la lectura y marca las etapas ya recorridas.
    const linea = document.querySelector<HTMLElement>("[data-linea]");
    if (linea) {
      const etapas = [...linea.querySelectorAll<HTMLElement>(".sg-etapa")];
      let pendiente = false;
      const pintar = () => {
        pendiente = false;
        const caja = linea.getBoundingClientRect();
        const lectura = window.innerHeight * 0.55;
        linea.style.setProperty("--avance", String(Math.max(0, Math.min(1, (lectura - caja.top) / caja.height))));
        for (const e of etapas) e.classList.toggle("is-pasada", e.getBoundingClientRect().top < lectura);
      };
      const programar = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); } };
      window.addEventListener("scroll", programar, { passive: true });
      window.addEventListener("resize", programar);
      pintar();
    }
  </script>
</BaseLayout>
