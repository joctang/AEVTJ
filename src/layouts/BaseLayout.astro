---
import "../styles/global.css";
import "../styles/editorial.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Tracking from "../components/Tracking.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
  image?: string;
}

const {
  title,
  description = "Asociación Española de Víctimas de los Testigos de Jehová y la JW.ORG. Escuchamos, apoyamos y ayudamos a recuperar la vida tras salir de la organización.",
  breadcrumbs,
  image,
} = Astro.props;
const canonicalPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = `https://victimasdetestigosdejehova.org${canonicalPath}`;
const ogImage = image
  ? image.startsWith("http") ? image : `https://victimasdetestigosdejehova.org/${image.replace(/^\//, "")}`
  : "https://victimasdetestigosdejehova.org/uploads/2025/10/Logo-avtj-300x300.png";
const twitterCard = image ? "summary_large_image" : "summary";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/uploads/2025/10/Logo-avtj-300x300.png" />
    <title>{title} · AEVTJ</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="AEVTJ" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <Tracking />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={["flex min-h-screen flex-col", {"inner-page": Astro.url.pathname !== "/"}]}>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <div class="site-progress" aria-hidden="true"></div>
    <Header />
    <main id="contenido" class="site-main flex-1" tabindex="-1">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      import "../scripts/editorial";
    </script>
  </body>
</html>
