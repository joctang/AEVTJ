---
import "../styles/contacto.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import TornEdge from "../components/TornEdge.astro";

const contacts = [
  {
    title: "Bienvenida o ayuda",
    para: "Si estás saliendo, ya has salido o necesitas apoyo.",
    email: "info@victimasdetestigosdejehova.org",
  },
  {
    title: "Organismos, instituciones y periodistas",
    para: "Consultas de medios, administraciones y entidades.",
    email: "medios@victimasdetestigosdejehova.org",
  },
  {
    title: "Secretaría",
    para: "Altas de socios, documentación y gestiones internas.",
    email: "secretaria@victimasdetestigosdejehova.org",
  },
];

const description =
  "Contacta con la Asociación Española de Víctimas de los Testigos de Jehová: bienvenida y ayuda, medios de comunicación e instituciones, y secretaría.";
---

<BaseLayout title="Contacto" description={description}>
  <div class="contacto">
    <section class="contacto-hero">
      <img
        class="contacto-hero__img"
        src="/uploads/2025/10/ju-on-e6XsI7qqvAA-unsplash-1.jpg"
        alt=""
        width="1920"
        height="1280"
        fetchpriority="high"
        decoding="async"
      />
      <div class="contacto-hero__scrim" aria-hidden="true"></div>
      <div class="contacto-hero__content">
        <p class="guia-kicker guia-kicker--crema">Estamos aquí</p>
        <h1>Contacto</h1>
        <p class="contacto-hero__entradilla">
          Queremos ayudarte. Escríbenos al correo que mejor encaje con tu caso o cuéntanos lo que
          necesitas en el formulario: te responderemos lo antes posible.
        </p>
      </div>
      <TornEdge />
    </section>

    <section class="contacto-correos" aria-labelledby="contacto-correos-titulo">
      <div class="contacto-correos__inner">
        <p class="guia-kicker" data-reveal>Correos de contacto</p>
        <h2 id="contacto-correos-titulo" data-reveal>Escribe a quien mejor pueda ayudarte</h2>
        <p class="contacto-correos__intro" data-reveal>
          Cada dirección la atiende un área distinta de la asociación. Elegir la correcta acelera la
          respuesta.
        </p>
        <div class="contacto-correos__grid">
          {
            contacts.map((c) => (
              <a class="contacto-correo" href={`mailto:${c.email}`} data-reveal>
                <h3>{c.title}</h3>
                <p class="contacto-correo__para">{c.para}</p>
                <span class="contacto-correo__email">{c.email}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="contacto-form-seccion" aria-labelledby="contacto-form-titulo">
      <div class="contacto-form-seccion__inner">
        <p class="guia-kicker" data-reveal>¿Tienes más preguntas?</p>
        <h2 id="contacto-form-titulo" data-reveal>Cuéntanos tu caso</h2>
        <p class="contacto-form-seccion__intro" data-reveal>
          Rellena el formulario y se abrirá tu programa de correo con el mensaje ya redactado, listo
          para enviar. Así los datos viajan directamente desde tu cuenta a la nuestra.
        </p>

        <form class="contacto-form" id="contacto-form" data-reveal novalidate>
          <div class="contacto-form__fila">
            <label>
              Nombre
              <input type="text" name="nombre" autocomplete="name" required />
            </label>
            <label>
              Email
              <input type="email" name="email" autocomplete="email" required />
            </label>
          </div>
          <label>
            Destinatario
            <select name="destinatario">
              {contacts.map((c) => <option value={c.email}>{c.title}</option>)}
            </select>
          </label>
          <label>
            Asunto
            <input type="text" name="asunto" required />
          </label>
          <label>
            Mensaje
            <textarea name="mensaje" rows="6" required></textarea>
          </label>
          <p class="contacto-form__nota">
            Este formulario no envía nada por sí mismo ni guarda tus datos: abre tu gestor de correo
            con el mensaje preparado. Si prefieres escribirnos directamente, usa una de las
            direcciones de arriba. Tratamos tus datos según nuestra
            <a href="/politica-de-privacidad/">Política de Privacidad</a>.
          </p>
          <div class="contacto-form__acciones">
            <button type="submit" class="guia-pill guia-pill--solid">Preparar mensaje</button>
            <p class="contacto-form__estado" id="contacto-form-estado" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  </div>

  <script>
    // El formulario no tiene backend: compone un mailto con lo escrito y abre
    // el gestor de correo del usuario. Nada sale del navegador por otra vía.
    const form = document.getElementById("contacto-form") as HTMLFormElement | null;
    const estado = document.getElementById("contacto-form-estado");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const datos = new FormData(form);
      const destinatario = String(datos.get("destinatario") ?? "");
      const nombre = String(datos.get("nombre") ?? "").trim();
      const email = String(datos.get("email") ?? "").trim();
      const asunto = String(datos.get("asunto") ?? "").trim();
      const mensaje = String(datos.get("mensaje") ?? "").trim();

      const cuerpo = `${mensaje}\n\n—\n${nombre}\n${email}`;
      const href =
        `mailto:${destinatario}` +
        `?subject=${encodeURIComponent(asunto)}` +
        `&body=${encodeURIComponent(cuerpo)}`;

      if (estado) estado.textContent = "Abriendo tu gestor de correo…";
      window.location.href = href;
    });
  </script>
</BaseLayout>
