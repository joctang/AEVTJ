---
import "../styles/socio.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import TornEdge from "../components/TornEdge.astro";

const FORMULARIO_SOCIO = "https://forms.gle/Hzx99iAKP6BZyqFx6";

const benefits = [
  "Recibe mensualmente nuestro boletín de noticias",
  "Formar parte de la toma de decisiones",
  "Crear y participar en comisiones de ayuda a las víctimas",
  "Acceder a la información financiera interna de la asociación",
  "Acceso a los grupos de apoyo de WhatsApp",
  "Presentar candidaturas para la junta directiva",
];

const steps = [
  "Accede a tu banca online o aplicación móvil",
  "Introduce el número de cuenta (IBAN) de AEVTJ",
  "Indica el importe que deseas donar",
  'En el concepto/asunto escribe: <strong>DONATIVO a AEVTJ</strong>',
  "Confirma y realiza la transferencia",
];

const contacts = [
  {
    title: "Ayuda y bienvenida",
    email: "info@victimasdetestigosdejehova.org",
  },
  {
    title: "Organismos, instituciones y periodistas",
    email: "medios@victimasdetestigosdejehova.org",
    link: { href: "/noticias/", label: "Noticias y comunicados" },
  },
  {
    title: "Secretaría",
    email: "secretaria@victimasdetestigosdejehova.org",
    tel: { numero: "+34 611 21 82 86", nota: "Solo WhatsApp" },
  },
];

const description =
  "Hazte socio de la Asociación Española de Víctimas de los Testigos de Jehová: alta gratuita, donaciones por transferencia o PayPal y colaboración a través de GoFundMe.";
---

<BaseLayout title="Hazte socio" description={description}>
  <div class="socio">
    <section class="socio-hero">
      <img
        class="socio-hero__img"
        src="/uploads/2025/10/pexels-fauxels-3184398.webp"
        alt=""
        width="1920"
        height="1280"
        fetchpriority="high"
        decoding="async"
      />
      <div class="socio-hero__scrim" aria-hidden="true"></div>
      <div class="socio-hero__content">
        <p class="guia-kicker guia-kicker--crema">Únete a la asociación</p>
        <h1>Hazte socio</h1>
        <p class="socio-hero__lema">Tu apoyo marca la diferencia</p>
        <p class="socio-hero__entradilla">
          Somos una asociación española sin ánimo de lucro dedicada a ayudar a las víctimas de los
          Testigos de Jehová. Contamos con el compromiso y la solidaridad de personas como tú para
          brindar apoyo a quienes lo necesitan y defendernos de posibles demandas legales.
        </p>
        <div class="socio-hero__actions">
          <a
            class="guia-pill guia-pill--solid"
            href={FORMULARIO_SOCIO}
            target="_blank"
            rel="nofollow noopener"
          >
            Hazte socio, es gratis
          </a>
          <a class="guia-pill guia-pill--ghost" href="#donaciones">Quiero donar</a>
        </div>
      </div>
      <TornEdge />
    </section>

    <section class="socio-vias" id="donaciones" aria-labelledby="socio-vias-titulo">
      <div class="socio-vias__inner">
        <p class="guia-kicker" data-reveal>Formas de colaborar</p>
        <h2 id="socio-vias-titulo" data-reveal>¿Cómo puedes colaborar con la asociación?</h2>

        <div class="socio-vias__grid">
          <div class="socio-card socio-card--destacada" data-reveal>
            <h3>Hazte socio de forma gratuita</h3>
            <p class="socio-card__lema">Forma parte del cambio</p>
            <span class="socio-etiqueta">Boletín mensual</span>
            <ul class="socio-beneficios">
              {
                benefits.map((b) => (
                  <li>
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m4 10.5 4 4 8-9" />
                    </svg>
                    {b}
                  </li>
                ))
              }
            </ul>
            <a
              class="guia-pill guia-pill--solid"
              href={FORMULARIO_SOCIO}
              target="_blank"
              rel="nofollow noopener"
            >
              Rellenar el formulario
            </a>
          </div>

          <div class="socio-card" data-reveal>
            <h3>Donaciones</h3>
            <p>
              Cualquier cantidad, por pequeña que sea, es invaluable para continuar con nuestra
              labor. Te invitamos a considerar hacer aportaciones periódicas; puedes fijar una fecha
              en tu calendario para contribuir de manera constante y apoyar este proyecto que no
              tiene límite temporal.
            </p>
            <div class="socio-paypal">
              <h4>PayPal</h4>
              <p>
                Para donaciones a través de PayPal, utiliza la dirección{" "}
                <strong>admon.aevtj@gmail.com</strong>. Selecciona la opción entre particulares para
                ahorrar en comisiones.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="socio-transferencia" aria-labelledby="socio-transferencia-titulo">
      <div class="socio-transferencia__inner" data-reveal>
        <p class="guia-kicker">Transferencia bancaria</p>
        <h2 id="socio-transferencia-titulo">Apoya a la asociación desde tu banco</h2>
        <p class="socio-transferencia__intro">
          Haz tus donaciones por transferencia a la cuenta de la{" "}
          <strong>Asociación Española de Víctimas de los Testigos de Jehová (AEVTJ)</strong>.
        </p>

        <h3>Datos bancarios</h3>
        <div class="socio-datos">
          <div class="socio-dato">
            <span class="socio-dato__clave">Banco</span>
            <span class="socio-dato__valor">BANCO SABADELL</span>
          </div>
          <div class="socio-dato">
            <span class="socio-dato__clave">IBAN</span>
            <span class="socio-dato__valor">ES66 0081 7171 7500 0181 3989</span>
            <button
              type="button"
              class="socio-copiar"
              data-value="ES6600817171750001813989"
              aria-label="Copiar el IBAN al portapapeles"
            >
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="5.5" y="5.5" width="9" height="9" rx="2" />
                <path d="M10.5 3.5a2 2 0 0 0-2-2h-5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2" />
              </svg>
              Copiar
            </button>
            <span class="socio-copiado" role="status" aria-live="polite"></span>
          </div>
          <div class="socio-dato">
            <span class="socio-dato__clave">BIC/SWIFT</span>
            <span class="socio-dato__valor">BSABESBB</span>
          </div>
        </div>

        <h3>Cómo realizar la transferencia</h3>
        <ol class="socio-pasos">
          {
            steps.map((s, i) => (
              <li>
                <span aria-hidden="true">{i + 1}</span>
                <span set:html={s} />
              </li>
            ))
          }
        </ol>

        <div class="socio-privacidad">
          <p><strong>Sobre el asunto o concepto.</strong></p>
          <p>
            <strong>No es necesario incluir tu nombre</strong> en el concepto de la transferencia si
            deseas permanecer en el anonimato. Si decides incluir tu nombre, ten la tranquilidad de
            que <strong>no se hará público</strong>. Respetamos tu privacidad.
          </p>
        </div>

        <div class="socio-gracias">
          <p>¡Gracias por tu solidaridad!</p>
          <p>
            Tu donación ayuda a apoyar a las víctimas y promover la concienciación sobre esta
            problemática.
          </p>
        </div>
      </div>
    </section>

    <section class="socio-gofundme" aria-labelledby="socio-gofundme-titulo">
      <div class="socio-gofundme__inner" data-reveal>
        <img
          src="/uploads/2025/10/GoFundMe-440-logo-300x194.webp"
          alt="GoFundMe"
          width="300"
          height="194"
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2 id="socio-gofundme-titulo">Otra forma de colaborar</h2>
          <p>
            Puedes colaborar con nosotros también a través de GoFundMe, la plataforma de{" "}
            <em>crowdfunding</em> (o micromecenazgo) en línea más grande y popular del mundo, que
            permite a organizaciones como la nuestra recaudar dinero y ayudarlas a seguir con sus
            proyectos.
          </p>
          <a
            href="https://www.gofundme.com/f/ayuda-a-la-asociacion-de-victimas-de-los-testigos-de-jehova"
            target="_blank"
            rel="nofollow noopener"
          >
            Ir a nuestra campaña en GoFundMe
          </a>
        </div>
      </div>
    </section>

    <section class="socio-cierre" aria-labelledby="socio-cierre-titulo">
      <div class="socio-cierre__inner">
        <p class="guia-kicker guia-kicker--crema" data-reveal>¿Tienes más preguntas?</p>
        <h2 id="socio-cierre-titulo" data-reveal>Estamos aquí para ayudarte</h2>
        <p class="socio-cierre__intro" data-reveal>
          Escríbenos al área que mejor encaje con tu consulta y nos pondremos en contacto a la mayor
          brevedad.
        </p>

        <div class="socio-contactos">
          {
            contacts.map((c) => (
              <div class="socio-contacto" data-reveal>
                <h3>{c.title}</h3>
                {c.tel && (
                  <p>
                    <a href={`https://wa.me/${c.tel.numero.replace(/[^0-9]/g, "")}`} target="_blank" rel="nofollow noopener">
                      {c.tel.numero}
                    </a>{" "}
                    · {c.tel.nota}
                  </p>
                )}
                <a href={`mailto:${c.email}`}>{c.email}</a>
                {c.link && <a href={c.link.href}>{c.link.label}</a>}
              </div>
            ))
          }
        </div>

        <div class="socio-cierre__actions" data-reveal>
          <a class="guia-pill guia-pill--solid" href={FORMULARIO_SOCIO} target="_blank" rel="nofollow noopener">
            Hazte socio
          </a>
          <a class="guia-pill guia-pill--navy" href="/contacto/">Escríbenos</a>
        </div>
      </div>
    </section>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>(".socio-copiar").forEach((btn) => {
      const aviso = btn.parentElement?.querySelector<HTMLElement>(".socio-copiado");
      btn.addEventListener("click", async () => {
        const value = btn.dataset.value ?? "";
        try {
          await navigator.clipboard.writeText(value);
          if (aviso) {
            aviso.textContent = "IBAN copiado";
            setTimeout(() => (aviso.textContent = ""), 2500);
          }
        } catch {
          if (aviso) aviso.textContent = "Cópialo manualmente";
        }
      });
    });
  </script>
</BaseLayout>
