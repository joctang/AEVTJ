---
import BaseLayout from "../layouts/BaseLayout.astro";
import TornEdge from "../components/TornEdge.astro";

const benefits = [
  "Recibe mensualmente nuestro boletín de noticias",
  "Formar parte de la toma de decisiones",
  "Crear y participar en comisiones de ayuda a las víctimas",
  "Acceder a la información financiera interna de la asociación",
  "Acceso a los grupos de apoyo de WhatsApp",
  "Presentar candidaturas para la junta directiva",
];

const steps = [
  "Accede a tu banca online o aplicación móvil",
  "Introduce el número de cuenta (IBAN) de AEVTJ",
  "Indica el importe que deseas donar",
  "En el concepto/asunto escribe: DONATIVO a AEVTJ",
  "Confirma y realiza la transferencia",
];

const contacts = [
  {
    title: "Correo de ayuda y bienvenida",
    lines: ["info@victimasdetestigosdejehova.org"],
  },
  {
    title: "Organismos, Institución y Periodistas",
    lines: ["medios@victimasdetestigosdejehova.org", "Por favor, consulta nuestras noticias"],
    link: { href: "/noticias/", label: "Noticias y comunicados" },
  },
  {
    title: "Secretaría",
    lines: ["+34 611 21 82 86 · Solo WhatsApp", "secretaria@victimasdetestigosdejehova.org"],
  },
];
---

<BaseLayout title="Hazte socio">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-ink text-white">
    <img
      src="/uploads/2025/10/pexels-fauxels-3184398.webp"
      alt="Grupo de personas sonriendo, socios de la asociación"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-brand-ink/75"></div>
    <div class="relative mx-auto max-w-[820px] px-5 py-20 text-center lg:px-8 lg:py-28">
      <h1 class="font-heading text-5xl font-bold uppercase tracking-wide sm:text-6xl">Hazte socio</h1>
      <p class="mt-2 text-lg text-white/85">Tu apoyo marca la diferencia</p>
      <p class="mx-auto mt-6 max-w-2xl text-white/90">
        Somos una asociación española sin ánimo de lucro dedicada a ayudar a las víctimas
        de los Testigos de Jehová. Contamos con el compromiso y la solidaridad de
        personas como tú para brindar apoyo a quienes lo necesitan y defendernos de
        posibles demandas legales.
      </p>
      <a
        href="https://forms.gle/Hzx99iAKP6BZyqFx6"
        target="_blank"
        rel="nofollow noopener"
        class="mt-6 inline-block font-heading text-sm font-semibold uppercase tracking-wide text-white underline underline-offset-4 hover:text-brand-cream"
      >
        Rellena nuestro formulario aquí
      </a>
    </div>
    <TornEdge />
  </section>

  <!-- Cómo colaborar -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 lg:px-8">
    <h2 class="text-center font-heading text-3xl font-semibold uppercase tracking-wide text-brand-ink sm:text-4xl">
      ¿Cómo puedes colaborar con la asociación?
    </h2>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- Hazte socio gratis -->
      <div class="overflow-hidden rounded-xl border border-black/5 shadow-sm">
        <div class="bg-brand-olive px-6 py-5 text-white">
          <h3 class="font-heading text-xl font-bold uppercase">Hazte socio de forma gratuita</h3>
          <p class="text-sm text-white/85">Forma parte del cambio</p>
        </div>
        <div class="p-6">
          <span class="inline-block rounded-full bg-brand-cream px-3 py-1 font-heading text-xs font-semibold uppercase tracking-wide text-brand-olive">
            Mensual
          </span>
          <ul class="mt-4 space-y-3">
            {
              benefits.map((b) => (
                <li class="flex items-start gap-2 text-sm text-brand-ink/80">
                  <span class="mt-0.5 text-brand-olive">✓</span>
                  {b}
                </li>
              ))
            }
          </ul>
          <a
            href="https://forms.gle/Hzx99iAKP6BZyqFx6"
            target="_blank"
            rel="nofollow noopener"
            class="mt-6 inline-block rounded-md bg-brand-olive px-6 py-2.5 font-heading text-sm font-semibold uppercase tracking-wide text-white hover:bg-brand-olive-dark"
          >
            Formulario
          </a>
        </div>
      </div>

      <!-- Donaciones -->
      <div class="rounded-xl border border-black/5 p-6 shadow-sm">
        <h3 class="font-heading text-xl font-bold uppercase text-brand-ink">Donaciones</h3>
        <p class="mt-3 text-sm text-brand-ink/75">
          Cualquier cantidad, por pequeña que sea, es invaluable para continuar con
          nuestra labor. Te invitamos a considerar hacer aportaciones periódicas; puedes
          fijar una fecha en tu calendario para contribuir de manera constante y apoyar
          este proyecto que no tiene límite temporal.
        </p>
        <div class="mt-6 rounded-lg bg-brand-cream p-5">
          <h4 class="font-heading text-base font-bold uppercase text-brand-ink">Paypal</h4>
          <p class="mt-2 text-sm text-brand-ink/75">
            Para donaciones a través de PayPal, utiliza la dirección:
            <strong>admon.aevtj@gmail.com</strong>. Selecciona la opción entre
            particulares para ahorrar en comisiones.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Transferencia bancaria -->
  <section class="bg-brand-cream">
    <div class="mx-auto max-w-[720px] px-5 py-16 lg:px-8">
      <div class="rounded-xl bg-white p-6 shadow-sm sm:p-10">
        <div class="text-center">
          <span class="text-3xl">💚</span>
          <h2 class="mt-2 font-heading text-2xl font-bold uppercase text-brand-ink sm:text-3xl">
            Transferencia bancaria
          </h2>
          <p class="mt-1 text-sm text-brand-ink/70">
            Apoya a la Asociación Española de Víctimas de los Testigos de Jehová
          </p>
        </div>

        <div class="mt-8">
          <h3 class="font-heading text-lg font-bold uppercase text-brand-ink">Datos bancarios</h3>
          <p class="mt-2 text-sm text-brand-ink/75">
            Haz tus donaciones por transferencia a la cuenta de la
            <strong>ASOCIACIÓN ESPAÑOLA DE VÍCTIMAS DE LOS TESTIGOS DE JEHOVÁ (AEVTJ)</strong>.
          </p>
          <div class="mt-4 space-y-2 rounded-lg border border-black/10 p-4 text-sm">
            <div class="flex items-center justify-between gap-3">
              <span class="text-brand-ink/60">Banco:</span>
              <span class="font-semibold text-brand-ink">BANCO SABADELL</span>
            </div>
            <div class="flex items-center justify-between gap-3">
              <span class="text-brand-ink/60">IBAN:</span>
              <span class="flex items-center gap-2 font-semibold text-brand-ink">
                ES66 0081 7171 7500 0181 3989
                <button
                  type="button"
                  class="copy-iban rounded border border-brand-olive/40 px-2 py-0.5 text-xs font-semibold uppercase text-brand-olive hover:bg-brand-olive/10"
                  data-value="ES6600817171750001813989"
                >
                  Copiar
                </button>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3">
              <span class="text-brand-ink/60">BIC/SWIFT:</span>
              <span class="font-semibold text-brand-ink">BSABESBB</span>
            </div>
          </div>
        </div>

        <div class="mt-8">
          <h3 class="font-heading text-lg font-bold uppercase text-brand-ink">Cómo realizar la transferencia</h3>
          <ol class="mt-4 space-y-3">
            {
              steps.map((s, i) => (
                <li class="flex items-start gap-3 text-sm text-brand-ink/80">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-olive text-xs font-bold text-white">
                    {i + 1}
                  </span>
                  {s}
                </li>
              ))
            }
          </ol>
        </div>

        <div class="mt-8 rounded-lg border border-brand-olive/20 bg-brand-cream p-4">
          <p class="font-heading text-sm font-semibold uppercase text-brand-ink">Sobre el asunto/concepto</p>
          <p class="mt-2 text-sm text-brand-ink/75">
            <strong>No es necesario incluir tu nombre</strong> en el concepto de la
            transferencia si deseas permanecer en el anonimato. Si decides incluir tu
            nombre, ten la tranquilidad de que <strong>no se hará público</strong>.
            Respetamos tu privacidad.
          </p>
        </div>

        <div class="mt-8 text-center text-sm text-brand-ink/70">
          <p class="font-semibold text-brand-ink">¡Gracias por tu solidaridad!</p>
          <p>Tu donación ayuda a apoyar a las víctimas y promover la concienciación sobre esta problemática</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Otra forma de colaborar -->
  <section class="mx-auto max-w-[720px] px-5 py-16 text-center lg:px-8">
    <h2 class="font-heading text-2xl font-semibold uppercase tracking-wide text-brand-ink sm:text-3xl">
      Otra forma de colaborar
    </h2>
    <a
      href="https://www.gofundme.com/f/ayuda-a-la-asociacion-de-victimas-de-los-testigos-de-jehova"
      target="_blank"
      rel="nofollow noopener"
      class="mt-6 inline-block"
    >
      <img src="/uploads/2025/10/GoFundMe-440-logo-300x194.webp" alt="GoFundMe" class="mx-auto h-14 w-auto" />
    </a>
    <p class="mt-4 text-brand-ink/75">Puedes colaborar con nosotros también a través de GoFundMe.</p>
    <p class="mt-2 text-sm text-brand-ink/70">
      GoFundMe es la plataforma de <em>crowdfunding</em> (o micromecenazgo) en línea más
      grande y popular del mundo, que permite a organizaciones como la nuestra recaudar
      dinero y ayudarlas a seguir con sus proyectos.
    </p>
  </section>

  <!-- Newsletter bar -->
  <section class="bg-brand-olive-dark text-white">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center justify-between gap-4 px-5 py-8 lg:flex-row lg:px-8">
      <h3 class="font-heading text-xl font-semibold uppercase tracking-wide">
        Mantente informado con nuestro boletín de noticias
      </h3>
      <form onsubmit="return false" class="flex w-full max-w-md flex-col gap-2 sm:flex-row">
        <input
          type="email"
          placeholder="Tu correo electrónico"
          class="w-full rounded-md border border-white/30 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/60 outline-none focus:border-white"
        />
        <button
          type="submit"
          class="shrink-0 rounded-md bg-white px-5 py-2 font-heading text-sm font-semibold uppercase tracking-wide text-brand-olive-dark hover:bg-brand-cream"
        >
          Quiero suscribirme
        </button>
      </form>
    </div>
  </section>

  <!-- Contactos -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-3">
      {
        contacts.map((c) => (
          <div class="rounded-xl border border-black/5 p-6 text-center shadow-sm">
            <h3 class="font-heading text-base font-bold uppercase text-brand-ink">{c.title}</h3>
            <div class="mt-3 space-y-1 text-sm text-brand-ink/75">
              {c.lines.map((l) => (
                <p>{l}</p>
              ))}
            </div>
            {c.link && (
              <a
                href={c.link.href}
                class="mt-3 inline-block font-heading text-sm font-semibold uppercase tracking-wide text-brand-olive hover:text-brand-olive-dark"
              >
                {c.link.label}
              </a>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Tienes mas preguntas -->
  <section class="bg-brand-cream">
    <div class="mx-auto max-w-[720px] px-5 py-16 lg:px-8">
      <h2 class="text-center font-heading text-4xl font-bold uppercase tracking-wide text-brand-ink sm:text-5xl">
        ¿Tienes más preguntas?
      </h2>
      <p class="mt-3 text-center text-brand-ink/75">
        Estamos aquí para ayudarte. Rellena el formulario y nos pondremos en contacto a
        la mayor brevedad.
      </p>

      <form onsubmit="return false" class="mt-8 flex flex-col gap-4 rounded-xl bg-white p-6 shadow-sm sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
            Tu nombre
            <input type="text" name="nombre" class="rounded-md border border-black/15 px-3 py-2 outline-none focus:border-brand-olive" />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
            Tus apellidos
            <input type="text" name="apellidos" class="rounded-md border border-black/15 px-3 py-2 outline-none focus:border-brand-olive" />
          </label>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
            Tu correo electrónico
            <input type="email" name="email" class="rounded-md border border-black/15 px-3 py-2 outline-none focus:border-brand-olive" />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
            Teléfono (opcional)
            <input type="tel" name="telefono" class="rounded-md border border-black/15 px-3 py-2 outline-none focus:border-brand-olive" />
          </label>
        </div>
        <label class="flex flex-col gap-1.5 text-sm font-medium text-brand-ink">
          Tu mensaje o consulta
          <textarea name="mensaje" rows="5" class="rounded-md border border-black/15 px-3 py-2 outline-none focus:border-brand-olive"></textarea>
        </label>
        <label class="flex items-start gap-2 text-xs text-brand-ink/60">
          <input type="checkbox" class="mt-0.5" />
          Tus datos solo se usarán para responder a tu consulta y nunca serán cedidos a
          terceros. Acepto la Política de Privacidad y el tratamiento de mis datos
          personales conforme al RGPD.
        </label>
        <button
          type="submit"
          class="self-start rounded-md bg-brand-olive px-6 py-2.5 font-heading text-sm font-semibold uppercase tracking-wide text-white hover:bg-brand-olive-dark"
        >
          Enviar mensaje
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-iban").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.dataset.value ?? "";
      try {
        await navigator.clipboard.writeText(value);
        const original = btn.textContent;
        btn.textContent = "¡Copiado!";
        setTimeout(() => (btn.textContent = original), 1500);
      } catch {
        // Clipboard API unavailable — ignore silently.
      }
    });
  });
</script>
