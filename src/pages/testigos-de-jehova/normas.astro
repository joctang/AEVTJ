---
// Normas y vida cotidiana: respuestas breves, alcance atribuido y fuentes enlazadas.
import "../../styles/guia-salida.css";
import "../../styles/normas.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TornEdge from "../../components/TornEdge.astro";

const titulo = "Normas de los Testigos de Jehová: qué pueden hacer y qué no";
const descripcion = "Normas de los Testigos de Jehová en su vida diaria: celebraciones, pareja, universidad, voto, alcohol, tabaco y otras pautas explicadas con fuentes.";
const revisado = "13 de octubre de 2026";
const hero = {
  src: "/uploads/2026/10/tdj-normas-hero-libros-1536.webp",
  srcset: "/uploads/2026/10/tdj-normas-hero-libros-900.webp 900w, /uploads/2026/10/tdj-normas-hero-libros-1536.webp 1536w",
  alt: "Libros de tapa antigua apilados junto a un cuaderno abierto y un bolígrafo.",
};
// Respuestas breves, con una categoría clara y un matiz útil en cada tarjeta.
const tabla = [
  { tema: "Cumpleaños", tipo: "rechaza", etiqueta: "No los celebran", resumen: "No celebran los cumpleaños.", dice: "La propia organización reconoce que la Biblia no los prohíbe directamente. Llega a esa conclusión por cómo interpreta algunos relatos bíblicos.", leer: '<a href="/testigos-de-jehova/cumpleanos/">Leer sobre cumpleaños</a>' },
  { tema: "Navidad", tipo: "rechaza", etiqueta: "No la celebran", resumen: "No celebran la Navidad.", dice: "Dicen que muchas costumbres navideñas tienen origen pagano. Además, Jesús pidió que se recordara su muerte y no dijo nada de celebrar su nacimiento.", leer: '<a href="/testigos-de-jehova/navidad/">Leer sobre Navidad</a><a href="/testigos-de-jehova/celebraciones/">Otras fiestas</a>' },
  { tema: "Pareja y sexualidad", tipo: "espera", etiqueta: "La pauta: otro Testigo bautizado", resumen: "La organización espera que la pareja sea otro Testigo bautizado.", dice: "También enseña que el sexo es solo para el matrimonio. Dice que cada uno decide con quién sale, pero siempre dentro de esas pautas.", leer: '<a href="#pareja">Ver pareja y matrimonio</a>' },
  { tema: "Universidad", tipo: "decide", etiqueta: "Decisión personal", resumen: "Hoy dicen que es una decisión de cada adulto.", dice: "Durante años, sus revistas desaconsejaron ir. En mayo de 2026 la organización lo reconoció y dejó la decisión a cada uno.", leer: '<a href="#estudios">Ver universidad</a>' },
  { tema: "Voto y política", tipo: "espera", etiqueta: "Neutralidad política", resumen: "Piden neutralidad política. Oficialmente, no se meten si alguien vota.", dice: "No apoyan a partidos ni candidatos y no se presentan a cargos públicos. En la práctica, muchos Testigos no votan.", leer: '<a href="#politica">Ver voto y política</a>' },
  { tema: "Alcohol", tipo: "espera", etiqueta: "Con moderación", resumen: "Pueden beber, pero emborracharse se considera pecado.", dice: "Beber con moderación está permitido. Si alguien se emborracha a menudo o en público, el manual interno prevé que intervengan los ancianos.", leer: '<a href="#vida-cotidiana">Ver alcohol y tabaco</a>' },
  { tema: "Tabaco", tipo: "rechaza", etiqueta: "No fumar", resumen: "Fumar se considera pecado.", dice: "También el tabaco de mascar, el rapé y los cigarrillos electrónicos con nicotina, aunque la Biblia no habla del tabaco.", leer: '<a href="#vida-cotidiana">Ver alcohol y tabaco</a>' },
  { tema: "Baile y entretenimiento", tipo: "decide", etiqueta: "Criterio personal", resumen: "No hay una prohibición general del baile ni una lista de películas o canciones prohibidas.", dice: "La organización da unos principios y cada uno decide qué ve, qué escucha o qué baila.", leer: '<a href="#entretenimiento">Ver baile y ocio</a>' },
  { tema: "Ropa y aspecto", tipo: "espera", etiqueta: "Arreglo y modestia", resumen: "Para las reuniones y la predicación piden ir arreglados y con ropa modesta.", dice: "Algunas pautas cambiaron en 2023 y 2024: hoy se permite la barba y que las mujeres lleven pantalón en algunas actividades.", leer: '<a href="/testigos-de-jehova/vestimenta/">Leer sobre vestimenta</a>' },
  { tema: "Sangre", tipo: "rechaza", etiqueta: "Sangre completa: no", resumen: "Siguen rechazando la sangre completa.", dice: "Desde septiembre de 2026, aceptar o donar glóbulos, plasma o plaquetas es una decisión de cada uno.", leer: '<a href="/testigos-de-jehova/sangre/">Ampliar información sobre sangre y transfusiones</a>' },
];
const fuentes = [
  { label: "Creencias, normas y prácticas", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/creencias-testigos-jehova/" },
  { label: "Neutralidad política", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/neutralidad-pol%C3%ADtica/" },
  { label: "Ceremonias nacionalistas", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/por-que-no-participan-ceremonias-nacionalistas-bandera/" },
  { label: "Guerra y servicio militar", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/por-qu%C3%A9-no-van-a-la-guerra/" },
  { label: "Noviazgo", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/testigos-noviazgo/" },
  { label: "Cónyuge que no comparte la religión", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/familias/" },
  { label: "Alcohol", href: "https://www.jw.org/es/ense%C3%B1anzas-b%C3%ADblicas/preguntas/beber-alcohol-pecado/" },
  { label: "Tabaco y fumar", href: "https://www.jw.org/es/ense%C3%B1anzas-b%C3%ADblicas/preguntas/es-pecado-fumar/" },
  { label: "Entretenimiento", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/censura-entretenimiento-testigos-de-jehov%C3%A1/" },
  { label: "Los Testigos de Jehová y la educación", href: "https://www.jw.org/es/biblioteca/folletos/Los-testigos-de-Jehov%C3%A1-y-la-educaci%C3%B3n/" },
  { label: "Estudios adicionales: orientación de mayo de 2026", href: "https://www.jw.org/es/biblioteca/revistas/atalaya-estudio-mayo-2026/C%C3%B3mo-tomar-buenas-decisiones-sobre-los-estudios-adicionales/" },
  { label: "Cambios de indumentaria de marzo de 2024", href: "https://www.jw.org/es/noticias/region/internacionales/2024-Informe-2-del-Cuerpo-Gobernante/" },
  { label: "Celebraciones", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/testigos-jehova-no-celebran-fiestas/" },
  { label: "Educación religiosa y predicación de los hijos", href: "https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/testigos-jehova-obligan-hijos-religion-predicar/" },
  { label: "La Atalaya (1999): voto y conciencia personal", href: "https://wol.jw.org/es/wol/d/r4/lp-s/1999807" },
  { label: "La Atalaya (2005): educación superior", href: "https://wol.jw.org/es/wol/d/r4/lp-s/2005726" },
  { label: "Guía confidencial para ancianos (2007), copia archivada", href: "https://wtsarchive.com/cfs/files/downloads/MLHN6FTPNL2JaiFpi/cg-E.pdf" },
  { label: "Manual confidencial para ancianos (2025), copia alojada por terceros", href: "https://www.scribd.com/document/922803273/202509-sfg-E" },
  { label: "Presentación ante comité parlamentario australiano (alegación, no conclusión del comité)", href: "https://www.aph.gov.au/DocumentStore.ashx?id=fb4004b6-b469-4b00-b7cf-e389796ff716&subId=667532" },
];
const secciones = [
  { id: "respuesta", corto: "Las normas" },
  { id: "variacion", corto: "Cómo leer las normas" },
  { id: "celebraciones", corto: "Celebraciones" }, { id: "pareja", corto: "Pareja" },
  { id: "estudios", corto: "Universidad" }, { id: "politica", corto: "Voto y política" },
  { id: "vida-cotidiana", corto: "Alcohol y tabaco" }, { id: "entretenimiento", corto: "Baile y ocio" },
  { id: "preguntas", corto: "Preguntas" },
];
const url = `${Astro.site ?? "https://victimasdetestigosdejehova.org/"}testigos-de-jehova/normas/`;
const preguntasFrecuentes = [
  { q: "¿Qué normas influyen más en la vida diaria?", a: "Las celebraciones, la pareja, la neutralidad política, la predicación y algunas decisiones médicas. Para saber cómo afectan de verdad hay que mirar lo que publican, lo que dicen sus manuales internos y lo que cuentan quienes las han vivido." },
  { q: "¿Qué ocurre si un Testigo de Jehová vota?", a: "Oficialmente, nada: su web dice que no interfieren si alguien vota, y La Atalaya de 1999 lo dejaba a la conciencia de cada uno. Algunos exmiembros cuentan otra cosa: una presentación ante un comité del Parlamento australiano afirma que votar puede traer rechazo social e incluso la expulsión." },
  { q: "¿Pueden celebrar cumpleaños o Navidad?", a: "No. No celebran ni cumpleaños ni Navidad. En sus páginas explicamos los motivos y lo que cuentan quienes crecieron así." },
  { q: "¿Puede un Testigo de Jehová salir con alguien de otra religión?", a: "La organización enseña que un Testigo bautizado solo debe salir con otro Testigo bautizado. Dice que cada uno decide con quién, pero siempre dentro de esa pauta." },
  { q: "¿Pueden ir a la universidad?", a: "Sí. Desde La Atalaya de mayo de 2026 es una decisión de cada adulto. Antes, sus publicaciones desaconsejaban ir, y la propia organización lo reconoce." },
  { q: "¿Pueden beber alcohol?", a: "Sí, con moderación. Emborracharse se considera pecado." },
  { q: "¿Pueden fumar o consumir tabaco?", a: "No. La organización considera que fumar es pecado, aunque reconoce que la Biblia no habla del tabaco." },
  { q: "¿Pueden bailar o ver películas?", a: "Sí. No hay una prohibición general del baile ni una lista de películas o canciones prohibidas. La organización da unos principios y cada uno decide." },
  { q: "¿Las normas son iguales para todos?", a: "Las normas son las mismas, pero cómo se aplican puede cambiar según la congregación, los ancianos y cada situación. Por eso separamos lo que dicen las publicaciones de lo que cuentan las personas." },
];
const jsonLd = {
  "@context": "https://schema.org", "@type": "Article", headline: titulo,
  description: descripcion, dateModified: "2026-10-13", mainEntityOfPage: url,
  author: { "@type": "Organization", name: "AEVTJ — Asociación Española de Víctimas de los Testigos de Jehová" },
  publisher: { "@type": "Organization", name: "AEVTJ" },
};
const faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: preguntasFrecuentes.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) };
---

<BaseLayout title={titulo} description={descripcion} image={hero.src} breadcrumbs={[{ label: "Testigos de Jehová", href: "/testigos-de-jehova/" }, { label: "Normas y vida cotidiana" }]}>
  <div class="guia normas">
    <nav class="guia-rail" aria-label="Secciones de la página"><ol>{secciones.map((s, i) => <li><a href={`#${s.id}`}><span>{i + 1}. {s.corto}</span></a></li>)}</ol><span class="guia-rail__progreso" aria-hidden="true"></span></nav>

    <section class="guia-hero normas-hero">
      <img class="guia-hero__img" src={hero.src} srcset={hero.srcset} sizes="100vw" alt={hero.alt} width="1536" height="864" fetchpriority="high" decoding="async" />
      <div class="guia-hero__scrim" aria-hidden="true"></div>
      <div class="guia-hero__content"><h1>Normas de los Testigos de Jehová: qué pueden hacer y qué no</h1><p class="guia-hero__entradilla">Qué celebran y qué no, con quién pueden salir, si pueden votar o ir a la universidad. Repasamos las normas más conocidas: lo que dice la organización y cómo se viven.</p><div class="guia-hero__actions"><a class="guia-pill guia-pill--solid" href="#respuesta">Ver las normas</a><a class="guia-pill guia-pill--ghost" href="#variacion">Cómo leer esta guía</a></div></div>
      <div class="guia-hero__bottom"><ul class="guia-hero__meta" aria-label="Sobre esta página"><li>{tabla.length} temas</li><li>Revisado el {revisado}</li></ul><a class="guia-hero__scroll" href="#respuesta">Empezar <span aria-hidden="true">↓</span></a></div><TornEdge />
    </section>

    <section class="normas-respuesta" id="respuesta" aria-labelledby="respuesta-titulo"><div class="normas-ancho"><h2 id="respuesta-titulo">¿Qué normas siguen los Testigos de Jehová?</h2><p class="normas-lead" data-reveal>Hay cosas que no celebran, otras en las que la organización marca una pauta clara y otras que, al menos sobre el papel, decide cada uno.</p>
        <div class="normas-filtros" data-reveal role="group" aria-label="Filtrar temas"><button class="normas-filtro is-active" type="button" data-filtro="todos" aria-pressed="true">Todos</button><button class="normas-filtro" type="button" data-filtro="rechaza" aria-pressed="false">No celebran o rechazan</button><button class="normas-filtro" type="button" data-filtro="espera" aria-pressed="false">Lo que espera la organización</button><button class="normas-filtro" type="button" data-filtro="decide" aria-pressed="false">Decide cada persona</button></div><p class="normas-filtros__estado" aria-live="polite">Mostrando los 10 temas.</p>
        <ul class="normas-mapa">{tabla.map((f, i) => <li class="normas-mapa__item" data-tipo={f.tipo} data-reveal style={`transition-delay:${(i % 2) * 150}ms`}><span class="normas-mapa__estado">{f.etiqueta}</span><h3>{f.tema}</h3><p class="normas-mapa__resumen">{f.resumen}</p><div class="normas-mapa__detalle"><p>{f.dice}</p></div><div class="normas-mapa__enlaces" set:html={f.leer} /></li>)}</ul>
        <p class="normas-mapa__nota" data-reveal>Lo que contamos sobre los ancianos y los comités sale de sus manuales internos, que hemos consultado en copias publicadas por terceros. Explican lo que puede pasar, aunque no todas las congregaciones lo aplican igual.</p><a class="normas-textlink" href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/creencias-testigos-jehova/" target="_blank" rel="noopener noreferrer">Cómo explica la organización sus creencias y prácticas ↗</a></div></section>

    <section class="normas-variacion normas-variacion--intro" id="variacion" aria-labelledby="variacion-titulo"><div class="normas-ancho"><p class="guia-kicker">Para entendernos</p><h2 id="variacion-titulo">¿Qué significa cada norma en la vida real?</h2><div class="normas-variacion__grid"><article data-reveal style="transition-delay:0ms"><h3>Lo que dice la organización</h3><p>Lo que publica en sus revistas, en su web y en sus manuales. Siempre te decimos de dónde sale.</p></article><article data-reveal style="transition-delay:150ms"><h3>Lo que decide cada uno</h3><p>En algunos temas, la organización dice que es una decisión de conciencia. Pero entre lo que se dice y la presión que se siente en la congregación puede haber mucha distancia.</p></article><article data-reveal style="transition-delay:300ms"><h3>Lo que vive cada familia</h3><p>Los testimonios cuentan cómo se aplicó una norma en un caso concreto. No sirven para hacer estadísticas, pero sí para entender lo que las revistas no cuentan.</p></article></div><p class="normas-legal" data-reveal>Y una aclaración: hablamos de normas religiosas, no de leyes. Lo que dice la ley depende de cada país.</p></div></section>


    <section class="normas-articulo normas-evidencia" id="celebraciones" aria-labelledby="celebraciones-titulo"><div class="normas-ancho normas-articulo__inner"><div><p class="guia-kicker">Celebraciones</p><h2 id="celebraciones-titulo">¿Celebran cumpleaños y Navidad?</h2><p data-reveal>No. Los Testigos de Jehová <strong>no celebran los cumpleaños ni la Navidad</strong>. Tampoco muchas otras fiestas populares. Te explicamos por qué y lo que cuentan quienes crecieron sin ellas:</p><div data-reveal class="normas-enlaces-tema"><a class="guia-pill guia-pill--solid" href="/testigos-de-jehova/cumpleanos/">Por qué no celebran los cumpleaños</a><a class="guia-pill guia-pill--navy" href="/testigos-de-jehova/navidad/">Por qué no celebran la Navidad</a><a class="guia-pill guia-pill--navy" href="/testigos-de-jehova/celebraciones/">Otras fiestas</a></div></div></div></section>

    <section class="normas-articulo normas-articulo--salvia normas-capitulo normas-capitulo--pareja" id="pareja" aria-labelledby="pareja-titulo"><div class="normas-ancho normas-articulo__inner"><div><p class="guia-kicker">Noviazgo y matrimonio</p><h2 id="pareja-titulo">¿Puede un Testigo de Jehová salir con alguien de otra religión?</h2><p data-reveal><strong>La organización recomienda que un Testigo bautizado salga solo con otro Testigo bautizado.</strong> Para ellos, empezar una relación es un paso serio que debe llevar al matrimonio.</p><p data-reveal>Su web dice que cada uno decide si quiere tener pareja y con quién, siempre dentro de sus pautas bíblicas. En la práctica, esa libertad tiene un límite claro: lo que se espera es que la pareja comparta la religión y esté bautizada.</p><p data-reveal>Si ya estás casado y tu pareja no es Testigo, la cosa cambia: la organización aconseja no separarse por motivos religiosos.</p><p class="normas-fuente-interna" data-reveal><strong>Fuentes:</strong> <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/testigos-noviazgo/" target="_blank" rel="noopener noreferrer">Qué dice la organización sobre el noviazgo ↗</a> · <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/familias/" target="_blank" rel="noopener noreferrer">Qué dice sobre matrimonios en los que solo una persona es Testigo ↗</a>.</p></div></div></section>

    <section class="normas-estudios normas-evidencia" id="estudios" aria-labelledby="estudios-titulo"><div class="normas-ancho normas-estudios__inner"><div><p class="guia-kicker">Universidad y educación superior</p><h2 id="estudios-titulo">¿Pueden ir a la universidad?</h2><p data-reveal><strong>Sí. Hoy la organización dice que es una decisión personal.</strong> Pero no siempre fue así, y ella misma lo reconoce. <a href="https://www.jw.org/es/biblioteca/revistas/atalaya-estudio-mayo-2026/C%C3%B3mo-tomar-buenas-decisiones-sobre-los-estudios-adicionales/" target="_blank" rel="noopener noreferrer">La Atalaya de mayo de 2026</a> admite que publicaciones anteriores recomendaban no ir a la universidad, y pide que nadie, tampoco los ancianos, juzgue la decisión de un adulto.</p><h3 data-reveal>Qué decían antes las publicaciones</h3><p data-reveal>En <a href="https://wol.jw.org/es/wol/d/r4/lp-s/101989324" target="_blank" rel="noopener noreferrer">1989, ¡Despertad! decía que era una decisión personal</a>, pero dedicaba varios párrafos a advertir de los peligros morales y espirituales y presentaba no ir como lo que ya hacían muchos jóvenes cristianos. El mensaje venía a ser: puedes elegir, pero si vas, pones en riesgo tu fe.</p><p data-reveal>En <a href="https://wol.jw.org/es/wol/d/r4/lp-s/2005726" target="_blank" rel="noopener noreferrer">2005, La Atalaya advertía a los padres de los peligros de la educación superior</a> y animaba a los jóvenes a buscar metas religiosas. En <a href="https://wol.jw.org/es/wol/d/r4/lp-s/402014442" target="_blank" rel="noopener noreferrer">2014</a> contraponía las metas de “este mundo” con servir más a Jehová, e incluía la historia de una mujer que había dejado la universidad.</p><p data-reveal>Nunca fue una prohibición formal. Pero un joven que leía esos artículos tenía claro cuál era la opción que se esperaba de él. Quien dejó de estudiar siguiendo esos consejos lo hizo con esa presión encima, aunque hoy la organización diga que siempre fue una decisión personal.</p><p class="normas-fuente-interna" data-reveal><strong>Fuentes primarias:</strong> <a href="https://wol.jw.org/es/wol/d/r4/lp-s/101989324" target="_blank" rel="noopener noreferrer">¡Despertad!, 22-5-1989 ↗</a> · <a href="https://wol.jw.org/es/wol/d/r4/lp-s/2005726" target="_blank" rel="noopener noreferrer">La Atalaya, 1-10-2005 ↗</a> · <a href="https://wol.jw.org/es/wol/d/r4/lp-s/402014442" target="_blank" rel="noopener noreferrer">La Atalaya, 15-6-2014 ↗</a> · <a href="https://www.jw.org/es/biblioteca/revistas/atalaya-estudio-mayo-2026/C%C3%B3mo-tomar-buenas-decisiones-sobre-los-estudios-adicionales/" target="_blank" rel="noopener noreferrer">La Atalaya, mayo de 2026 ↗</a>.</p></div><figure class="normas-media layered-media" data-reveal><img src="/uploads/2026/10/tdj-normas-universidad-1536.webp" srcset="/uploads/2026/10/tdj-normas-universidad-900.webp 900w, /uploads/2026/10/tdj-normas-universidad-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 520px" alt="Ilustración de una estudiante entrando en un aula universitaria con un hilo lima que avanza hacia el espacio abierto." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span></figure></div></section>

    <section class="normas-articulo normas-evidencia normas-capitulo normas-capitulo--politica" id="politica" aria-labelledby="politica-titulo"><div class="normas-ancho normas-articulo__inner"><div><p class="guia-kicker">Voto y neutralidad política</p><h2 id="politica-titulo">¿Pueden votar los Testigos de Jehová?</h2><p data-reveal>No hay ninguna norma oficial que les prohíba votar. <strong>Lo que pide la organización es neutralidad política, y en la práctica muchos Testigos no votan.</strong> Su <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/neutralidad-pol%C3%ADtica/" target="_blank" rel="noopener noreferrer">web</a> dice que no apoyan a ningún partido ni candidato, que no se presentan a cargos públicos y que «tampoco interferimos si alguien decide votar».</p><figure class="normas-media normas-media--soft layered-media normas-politica__figura" data-reveal><img src="/uploads/2026/10/tdj-normas-voto-urna-hilo-1536.webp" srcset="/uploads/2026/10/tdj-normas-voto-urna-hilo-900.webp 900w, /uploads/2026/10/tdj-normas-voto-urna-hilo-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 520px" alt="Ilustración de una persona depositando una papeleta en blanco en una urna; un hilo verde la conecta con su mano." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span></figure><h3 data-reveal>¿Por qué muchos no votan?</h3><p data-reveal>Dan varias razones: que los cristianos no son «parte del mundo», que son embajadores del Reino de Dios, que si votas a alguien te haces responsable de lo que haga, que la política divide a las congregaciones y que, si son neutrales, pueden predicar a cualquiera.</p><p data-reveal>Pero no lo presentan como un mandato bíblico. En <a href="https://wol.jw.org/es/wol/d/r4/lp-s/1999807" target="_blank" rel="noopener noreferrer">1999, La Atalaya</a> decía que no veía nada en la Biblia contra votar en sí y que «cada Testigo es responsable de tomar una decisión en conciencia y basada en la Biblia».</p><h3 data-reveal>¿Qué pasa si votan?</h3><p data-reveal>Ninguna norma escrita dice que votar sea motivo de expulsión. Pero algunos exmiembros cuentan otra cosa. Uno de los testimonios mejor documentados es una <a href="https://www.aph.gov.au/DocumentStore.ashx?id=fb4004b6-b469-4b00-b7cf-e389796ff716&amp;subId=667532" target="_blank" rel="noopener noreferrer">presentación escrita ante un comité del Parlamento australiano (Submission 53)</a>, que afirma que votar puede acabar en expulsión y rechazo social. Es el testimonio de quien la presentó, no una conclusión del comité.</p><p data-reveal>Si votaste y en tu congregación te dijeron o te hicieron algo por ello, <a href="/contacto/">cuéntanoslo</a>. Con la fecha, el país y lo que pasó, podemos documentarlo.</p><h3 data-reveal>¿Y en España?</h3><p data-reveal>En España votar no es obligatorio, así que el problema no se plantea igual. En los países donde sí lo es, La Atalaya de 1999 decía que cada Testigo decide en conciencia y que «lo que haga una vez allí queda entre él y su Creador».</p><h3 data-reveal>¿Y la bandera, el himno y la guerra?</h3><p data-reveal>La neutralidad también se nota en que no <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/por-que-no-participan-ceremonias-nacionalistas-bandera/" target="_blank" rel="noopener noreferrer">saludan a la bandera ni cantan el himno</a> y en que <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/por-qu%C3%A9-no-van-a-la-guerra/" target="_blank" rel="noopener noreferrer">no van a la guerra</a>. Lo del servicio militar y sus alternativas depende de las leyes de cada país.</p><p class="normas-fuente-interna" data-reveal><strong>Fuentes:</strong> <a href="https://wol.jw.org/es/wol/d/r4/lp-s/1999807" target="_blank" rel="noopener noreferrer">La Atalaya, 1-11-1999, «Preguntas de los lectores» ↗</a> · <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/neutralidad-pol%C3%ADtica/" target="_blank" rel="noopener noreferrer">FAQ oficial sobre neutralidad política ↗</a>.</p></div></div></section>

    <section class="normas-articulo normas-articulo--salvia normas-vida" id="vida-cotidiana" aria-labelledby="cotidiana-titulo"><div class="normas-ancho normas-vida__inner"><div><p class="guia-kicker">Consumo y salud</p><h2 id="cotidiana-titulo">Alcohol y tabaco: dos pautas distintas</h2><h3 data-reveal>¿Pueden beber alcohol?</h3><p data-reveal>Sí. La <a href="https://www.jw.org/es/ense%C3%B1anzas-b%C3%ADblicas/preguntas/beber-alcohol-pecado/" target="_blank" rel="noopener noreferrer">organización</a> permite beber con moderación, pero considera pecado emborracharse. Su manual confidencial para ancianos distingue entre una borrachera aislada y en privado, en la que puede bastar con un consejo, y emborracharse a menudo o en público, que puede acabar en un comité. Tomarse una copa no tiene consecuencias.</p><h3 data-reveal>¿Pueden fumar o consumir tabaco?</h3><p data-reveal>No. La <a href="https://www.jw.org/es/ense%C3%B1anzas-b%C3%ADblicas/preguntas/es-pecado-fumar/" target="_blank" rel="noopener noreferrer">organización</a> reconoce que la Biblia no habla del tabaco, pero concluye que fumar es pecado porque va contra principios sobre la limpieza, la salud y el cuidado de los demás. Aplica lo mismo al tabaco de mascar, al rapé y a los cigarrillos electrónicos con nicotina.</p></div><aside class="normas-articulo__nota" data-reveal><strong>Beber no es lo mismo que fumar</strong><p data-reveal>El alcohol está permitido con moderación. El tabaco, en cambio, no se permite de ninguna forma.</p></aside></div><div class="normas-ancho normas-vida__ilustraciones"><figure class="normas-media layered-media" data-reveal><img src="/uploads/2026/10/tdj-normas-alcohol-copa-hilo-1536.webp" srcset="/uploads/2026/10/tdj-normas-alcohol-copa-hilo-900.webp 900w, /uploads/2026/10/tdj-normas-alcohol-copa-hilo-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 46vw" alt="Ilustración de una copa con una pequeña cantidad de bebida junto a una botella cerrada; un hilo verde rodea la base de la copa." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span><figcaption>Alcohol: permitido con moderación.</figcaption></figure><figure class="normas-media normas-media--round layered-media" data-reveal style="transition-delay:150ms"><img src="/uploads/2026/10/tdj-normas-tabaco-vape-hilo-1536.webp" srcset="/uploads/2026/10/tdj-normas-tabaco-vape-hilo-900.webp 900w, /uploads/2026/10/tdj-normas-tabaco-vape-hilo-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 46vw" alt="Ilustración de un cigarrillo sin encender y un vapeador; el hilo verde se detiene antes de llegar a ellos." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span><figcaption>Tabaco: no se permite.</figcaption></figure></div></section>

    <section class="normas-ocio normas-ocio--baile" id="entretenimiento" aria-labelledby="entretenimiento-titulo"><div class="normas-ancho normas-ocio__inner"><figure class="normas-media normas-media--soft layered-media" data-reveal><img src="/uploads/2026/10/tdj-normas-baile-1536.webp" srcset="/uploads/2026/10/tdj-normas-baile-900.webp 900w, /uploads/2026/10/tdj-normas-baile-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 520px" alt="Ilustración de tres personas adultas bailando en una reunión social, unidas visualmente por un hilo lima." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span></figure><div><p class="guia-kicker">Ocio y vida social</p><h2 id="entretenimiento-titulo">Baile y entretenimiento</h2><h3 data-reveal>¿Está prohibido bailar?</h3><p data-reveal>No. No hay ninguna prohibición general del baile. Que un baile concreto se vea bien o mal depende del ambiente y del criterio de cada uno.</p><h3 data-reveal>¿Pueden escuchar música o ver películas?</h3><p data-reveal>Sí. La organización dice que <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/censura-entretenimiento-testigos-de-jehov%C3%A1/" target="_blank" rel="noopener noreferrer">no tiene una lista de películas, canciones o libros prohibidos</a>. Lo que hace es publicar principios para que cada uno elija.</p></div></div></section>

    <section class="normas-articulo normas-articulo--salvia" id="otras-pautas" aria-labelledby="otras-titulo"><div class="normas-ancho"><p class="guia-kicker">Otras prácticas relevantes</p><h2 id="otras-titulo">Predicación, ropa y decisiones médicas</h2><div class="normas-variacion__grid"><article data-reveal style="transition-delay:0ms"><h3>Predicación</h3><p>Para la organización, predicar es una parte central de su fe y de la educación de los hijos. Su manual interno prevé que cada mes se registre la actividad de predicación de cada publicador. <a href="https://www.jw.org/es/testigos-de-jehov%C3%A1/preguntas-frecuentes/testigos-jehova-obligan-hijos-religion-predicar/" target="_blank" rel="noopener noreferrer">Ver la FAQ institucional ↗</a> · <a href="https://www.scribd.com/document/922803273/202509-sfg-E" target="_blank" rel="noopener noreferrer">Manual interno de 2025, copia externa ↗</a></p></article><article data-reveal style="transition-delay:150ms"><h3>Ropa y aspecto</h3><p>Hay pautas para vestir en las reuniones y en la predicación, pero algunas cambiaron en 2023 y 2024. Hoy ya no es verdad que ningún hombre pueda llevar barba ni que ninguna mujer pueda llevar pantalón. <a href="/testigos-de-jehova/vestimenta/">Ver la página sobre vestimenta</a> · <a href="https://www.jw.org/es/noticias/region/internacionales/2024-Informe-2-del-Cuerpo-Gobernante/" target="_blank" rel="noopener noreferrer">Informe de 2024 ↗</a></p></article><article data-reveal style="transition-delay:300ms"><h3>Sangre</h3><p>La postura sobre la sangre ha cambiado mucho con los años, la última vez en septiembre de 2026. Lo contamos en detalle en <a href="/testigos-de-jehova/sangre/">la página sobre sangre y transfusiones</a>.</p></article></div><div data-reveal class="normas-enlaces-tema normas-sangre-cta"><a class="guia-pill guia-pill--solid" href="/testigos-de-jehova/sangre/">Ampliar información sobre sangre y transfusiones</a></div></div></section>

    <section class="normas-faq" id="preguntas" aria-labelledby="preguntas-titulo"><div class="normas-ancho"><p class="guia-kicker">Dudas habituales</p><h2 id="preguntas-titulo">Preguntas frecuentes</h2><div class="normas-faq__lista">{preguntasFrecuentes.map(({ q, a }) => <details data-reveal><summary>{q}<span aria-hidden="true">＋</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="guia-cierre normas-mirada" id="criterio" aria-labelledby="criterio-titulo"><div class="guia-cierre__inner"><p class="guia-kicker guia-kicker--crema" data-reveal>La mirada de la AEVTJ</p><h2 id="criterio-titulo" data-reveal>Respetar la fe y escuchar a las personas</h2><p data-reveal>Respetamos que cada persona viva su fe como quiera. Lo que nos preocupa es cuando una norma deja de ser una decisión libre: cuando alguien no se atreve a votar, a estudiar o a ir a un cumpleaños por miedo a lo que pensará su congregación.</p><p data-reveal>Varias de estas normas han cambiado con los años. Con la universidad o la sangre, lo que antes se presentaba como lo correcto hoy es una decisión de cada uno. Quien vivió las versiones anteriores tiene derecho a contarlo y a que le escuchen. Si es tu caso, <a href="/contacto/">escríbenos</a>.</p><p class="guia-kicker guia-kicker--crema sg-sigue" data-reveal>Sigue leyendo</p><div class="guia-recursos"><a class="guia-recurso" href="/testigos-de-jehova/" data-reveal><h3>Quiénes son</h3><p>Una introducción a sus creencias y organización.</p></a><a class="guia-recurso" href="/testigos-de-jehova/sangre/" data-reveal><h3>Sangre y transfusiones</h3><p>Historia, postura y cambios documentados.</p></a><a class="guia-recurso" href="/guia-para-salir-de-los-testigos-de-jehova/" data-reveal><h3>Guía para salir</h3><p>Información para quien se plantea dejar la organización.</p></a></div><div class="guia-cierre__actions" data-reveal><a class="guia-pill guia-pill--solid" href="/contacto/">Contacta con la asociación</a><a class="guia-pill guia-pill--ghost" href="/recursos-de-ayuda/">Recursos de ayuda</a></div></div></section>

    <section class="normas-fuentes" aria-labelledby="fuentes-titulo"><h2 id="fuentes-titulo">Fuentes institucionales e internas consultadas</h2><ul>{fuentes.map((f) => <li><a href={f.href} target="_blank" rel="noopener noreferrer">{f.label} ↗</a></li>)}</ul><p class="normas-fuentes__fecha">Revisado el {revisado}. Las normas pueden cambiar: fíjate en la fecha de cada fuente.</p></section>
