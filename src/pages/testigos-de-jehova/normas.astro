<script>
  const filtrosNormas = document.querySelectorAll<HTMLButtonElement>(".normas-filtro");
  const tarjetasNormas = document.querySelectorAll<HTMLElement>(".normas-mapa__item");
  const estadoFiltrosNormas = document.querySelector<HTMLElement>(".normas-filtros__estado");
  filtrosNormas.forEach((boton) => boton.addEventListener("click", () => {
    const filtro = boton.dataset.filtro ?? "todos";
    let visibles = 0;
    tarjetasNormas.forEach((tarjeta) => {
      const mostrar = filtro === "todos" || tarjeta.dataset.tipo === filtro;
      tarjeta.hidden = !mostrar;
      if (mostrar) visibles += 1;
    });
    filtrosNormas.forEach((otro) => {
      const activo = otro === boton;
      otro.classList.toggle("is-active", activo);
      otro.setAttribute("aria-pressed", String(activo));
    });
    if (estadoFiltrosNormas) estadoFiltrosNormas.textContent = `Mostrando ${visibles} ${visibles === 1 ? "tema" : "temas"}.`;
  }));
</script>
