---
// Normas y vida cotidiana: artículo cerrado editorialmente el 18-10-2026 (06_Contenido/CRITERIO_EDITORIAL_PERIODISTICO.md).
// Respuestas breves, alcance atribuido y fuentes enlazadas; sin manuales internos.
import "../../styles/guia-salida.css";
import "../../styles/normas.css";
import "../../styles/referencias.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TornEdge from "../../components/TornEdge.astro";
import TarjetaRelacionado from "../../components/TarjetaRelacionado.astro";

const titulo = "Normas de los Testigos de Jehová: qué pueden hacer y qué no";
const descripcion = "Normas de los Testigos de Jehová en su vida diaria: celebraciones, pareja, universidad, voto, alcohol, tabaco y otras pautas explicadas con fuentes.";
const revisado = "18 de octubre de 2026";
const enlacesFinales = [
  { titulo: "Quiénes son", descripcion: "Una introducción a sus creencias y organización.", href: "/testigos-de-jehova/" },
  { titulo: "Sangre y transfusiones", descripcion: "Historia, postura y cambios documentados.", href: "/testigos-de-jehova/sangre/" },
  { titulo: "Guía para salir", descripcion: "Información para quien se plantea dejar la organización.", href: "/guia-para-salir-de-los-testigos-de-jehova/" },
];
const hero = {
  src: "/uploads/2026/10/tdj-normas-hero-libros-1536.webp",
  srcset: "/uploads/2026/10/tdj-normas-hero-libros-900.webp 900w, /uploads/2026/10/tdj-normas-hero-libros-1536.webp 1536w",
  alt: "Libros de tapa antigua apilados junto a un cuaderno abierto y un bolígrafo.",
};
// Respuestas breves, con una categoría clara y un matiz útil en cada tarjeta.
const tabla = [
  { tema: "Cumpleaños", tipo: "rechaza", etiqueta: "No los celebran", resumen: "No celebran los cumpleaños.", dice: "La propia organización reconoce que la Biblia no los prohíbe directamente. Llega a esa conclusión por cómo interpreta algunos relatos bíblicos.", leer: '<a href="/testigos-de-jehova/cumpleanos/">Leer sobre cumpleaños</a>' },
  { tema: "Navidad", tipo: "rechaza", etiqueta: "No la celebran", resumen: "No celebran la Navidad.", dice: "Dicen que muchas costumbres navideñas tienen origen pagano. Además, Jesús pidió que se recordara su muerte y no dijo nada de celebrar su nacimiento.", leer: '<a href="/testigos-de-jehova/navidad/">Leer sobre Navidad</a><a href="/testigos-de-jehova/celebraciones/">Otras fiestas</a>' },
  { tema: "Pareja y sexualidad", tipo: "espera", etiqueta: "La pauta: otro Testigo bautizado", resumen: "La organización espera que la pareja sea otro Testigo bautizado.", dice: "También enseña que el sexo es solo para el matrimonio. Dice que cada uno decide con quién sale, pero siempre dentro de esas pautas.", leer: '<a href="#pareja">Ver pareja y matrimonio</a>' },
  { tema: "Universidad", tipo: "decide", etiqueta: "Decisión personal", resumen: "Hoy dicen que es una decisión de cada adulto.", dice: "Durante años, sus revistas desaconsejaron ir. En mayo de 2026 la organización lo reconoció y dejó la decisión a cada uno.", leer: '<a href="#estudios">Ver universidad</a>' },
  { tema: "Voto y política", tipo: "espera", etiqueta: "Neutralidad política", resumen: "Piden neutralidad política. Oficialmente, no se meten si alguien vota.", dice: "No apoyan a partidos ni candidatos y no se presentan a cargos públicos. En 1964 sus revistas decían que no votaban; desde 1999 lo dejan a la conciencia. En la práctica, muchos Testigos no votan.", leer: '<a href="#politica">Ver voto y política</a>' },
  { tema: "Alcohol", tipo: "espera", etiqueta: "Con moderación", resumen: "Pueden beber, pero emborracharse se considera pecado.", dice: "Beber con moderación está permitido, pero la organización considera pecado emborracharse.", leer: '<a href="#vida-cotidiana">Ver alcohol y tabaco</a>' },
  { tema: "Tabaco", tipo: "rechaza", etiqueta: "No fumar", resumen: "Fumar se considera pecado.", dice: "También el tabaco de mascar, el rapé y los cigarrillos electrónicos con nicotina, aunque la Biblia no habla del tabaco. Hasta 1973 se bautizaba a personas que fumaban.", leer: '<a href="#vida-cotidiana">Ver alcohol y tabaco</a>' },
  { tema: "Baile y entretenimiento", tipo: "decide", etiqueta: "Criterio personal", resumen: "No hay una prohibición general del baile ni una lista de películas o canciones prohibidas.", dice: "La organización da unos principios y cada uno decide qué ve, qué escucha o qué baila.", leer: '<a href="#entretenimiento">Ver baile y ocio</a>' },
  { tema: "Ropa y aspecto", tipo: "espera", etiqueta: "Arreglo y modestia", resumen: "Para las reuniones y la predicación piden ir arreglados y con ropa modesta.", dice: "Algunas pautas cambiaron en 2023 y 2024: hoy se permite la barba y que las mujeres lleven pantalón en algunas actividades.", leer: '<a href="/testigos-de-jehova/vestimenta/">Leer sobre vestimenta</a>' },
  { tema: "Sangre", tipo: "rechaza", etiqueta: "Sangre completa: no", resumen: "Siguen rechazando la sangre completa.", dice: "Desde septiembre de 2026, aceptar o donar glóbulos, plasma o plaquetas es una decisión de cada uno.", leer: '<a href="/testigos-de-jehova/sangre/">Ampliar información sobre sangre y transfusiones</a>' },
];
const secciones = [
  { id: "respuesta", corto: "Las normas" },
  { id: "variacion", corto: "Cómo leer las normas" },
  { id: "celebraciones", corto: "Celebraciones" }, { id: "pareja", corto: "Pareja" },
  { id: "estudios", corto: "Universidad" }, { id: "politica", corto: "Voto y política" },
  { id: "vida-cotidiana", corto: "Alcohol y tabaco" }, { id: "entretenimiento", corto: "Baile y ocio" },
  { id: "preguntas", corto: "Preguntas" },
];
const url = `${Astro.site ?? "https://victimasdetestigosdejehova.org/"}testigos-de-jehova/normas/`;
const preguntasFrecuentes = [
  { q: "¿Qué normas influyen más en la vida diaria?", a: "Las celebraciones, la pareja, la neutralidad política, la predicación y algunas decisiones médicas. Para saber cómo afectan de verdad hay que mirar lo que publican y lo que cuentan quienes las han vivido." },
  { q: "¿Qué ocurre si un Testigo de Jehová vota?", a: "Oficialmente, nada: su web dice que no interfieren si alguien vota, y La Atalaya de 1999 lo dejaba a la conciencia de cada uno. Antes no era así: en 1964 la misma revista decía que los Testigos no participan en votar en las elecciones. Además, una presentación ante un comité del Parlamento australiano afirma que votar puede traer rechazo social e incluso la expulsión." },
  { q: "¿Pueden celebrar cumpleaños o Navidad?", a: "No. No celebran ni cumpleaños ni Navidad. En sus páginas explicamos los motivos y lo que cuentan quienes crecieron así." },
  { q: "¿Puede un Testigo de Jehová salir con alguien de otra religión?", a: "La organización enseña que un Testigo bautizado solo debe salir con otro Testigo bautizado. Dice que cada uno decide con quién, pero siempre dentro de esa pauta." },
  { q: "¿Pueden ir a la universidad?", a: "Sí. Desde La Atalaya de mayo de 2026 es una decisión de cada adulto. Antes, sus publicaciones desaconsejaban ciertos estudios, y la propia organización lo reconoce." },
  { q: "¿Pueden beber alcohol?", a: "Sí, con moderación. Emborracharse se considera pecado." },
  { q: "¿Pueden fumar o consumir tabaco?", a: "No. La organización considera que fumar es pecado, aunque reconoce que la Biblia no habla del tabaco. Hasta 1973 se bautizaba a personas que fumaban; ese año La Atalaya dio un plazo para dejarlo y dijo que quien no lo hiciera debía ser removido de la congregación." },
  { q: "¿Pueden bailar o ver películas?", a: "Sí. No hay una prohibición general del baile ni una lista de películas o canciones prohibidas. La organización da unos principios y cada uno decide." },
  { q: "¿Las normas son iguales para todos?", a: "Las normas son las mismas, pero cómo se aplican puede cambiar según la congregación, los ancianos y cada situación. Por eso separamos lo que dicen las publicaciones de lo que cuentan las personas." },
];
const jsonLd = {
  "@context": "https://schema.org", "@type": "Article", headline: titulo,
  description: descripcion, dateModified: "2026-10-18", mainEntityOfPage: url,
  author: { "@type": "Organization", name: "AEVTJ — Asociación Española de Víctimas de los Testigos de Jehová" },
  publisher: { "@type": "Organization", name: "AEVTJ" },
};
const faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: preguntasFrecuentes.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) };
---

<BaseLayout title={titulo} description={descripcion} image={hero.src} breadcrumbs={[{ label: "Testigos de Jehová", href: "/testigos-de-jehova/" }, { label: "Normas y vida cotidiana" }]}>
  <div class="guia normas">
    <nav class="guia-rail" aria-label="Secciones de la página"><ol>{secciones.map((s, i) => <li><a href={`#${s.id}`}><span>{i + 1}. {s.corto}</span></a></li>)}<li><a href="#fuentes"><span>Fuentes</span></a></li></ol><span class="guia-rail__progreso" aria-hidden="true"></span></nav>

    <section class="guia-hero normas-hero">
      <img class="guia-hero__img" src={hero.src} srcset={hero.srcset} sizes="100vw" alt={hero.alt} width="1536" height="864" fetchpriority="high" decoding="async" />
      <div class="guia-hero__scrim" aria-hidden="true"></div>
      <div class="guia-hero__content"><h1>Normas de los Testigos de Jehová: qué pueden hacer y qué no</h1><p class="guia-hero__entradilla">Qué celebran y qué no, con quién pueden salir, si pueden votar o ir a la universidad. Repasamos las normas más conocidas: lo que dice la organización y cómo se viven.</p></div>
      <div class="guia-hero__bottom"><ul class="guia-hero__meta" aria-label="Sobre esta página"><li>{tabla.length} temas</li><li>Revisado el {revisado}</li></ul><a class="guia-hero__scroll" href="#respuesta">Empezar <span aria-hidden="true">↓</span></a></div><TornEdge />
    </section>

    <section class="normas-respuesta" id="respuesta" aria-labelledby="respuesta-titulo"><div class="normas-ancho"><h2 id="respuesta-titulo">¿Qué normas siguen los Testigos de Jehová?</h2><p class="normas-lead" data-reveal>Hay cosas que no celebran, otras en las que la organización marca una pauta clara y otras que, al menos sobre el papel, decide cada uno.</p>
        <div class="normas-filtros" data-reveal role="group" aria-label="Filtrar temas"><button class="normas-filtro is-active" type="button" data-filtro="todos" aria-pressed="true">Todos</button><button class="normas-filtro" type="button" data-filtro="rechaza" aria-pressed="false">No celebran o rechazan</button><button class="normas-filtro" type="button" data-filtro="espera" aria-pressed="false">Lo que espera la organización</button><button class="normas-filtro" type="button" data-filtro="decide" aria-pressed="false">Decide cada persona</button></div><p class="normas-filtros__estado" aria-live="polite">Mostrando los 10 temas.</p>
        <ul class="normas-mapa">{tabla.map((f, i) => <li class="normas-mapa__item" data-tipo={f.tipo} data-reveal style={`transition-delay:${(i % 2) * 150}ms`}><span class="normas-mapa__estado">{f.etiqueta}</span><h3>{f.tema}</h3><p class="normas-mapa__resumen">{f.resumen}</p><div class="normas-mapa__detalle"><p>{f.dice}</p></div><div class="normas-mapa__enlaces" set:html={f.leer} /></li>)}</ul>
        <span class="normas-textlink">Cómo explica la organización sus creencias y prácticas <sup class="ad-ref" id="ref-1"><a href="#fn-1" aria-label="Fuente 1">1</a></sup></span></div></section>

    <section class="normas-variacion normas-variacion--intro" id="variacion" aria-labelledby="variacion-titulo"><div class="normas-ancho"><p class="guia-kicker">Para entendernos</p><h2 id="variacion-titulo">¿Qué significa cada norma en la vida real?</h2><div class="normas-variacion__grid"><article data-reveal style="transition-delay:0ms"><h3>Lo que dice la organización</h3><p>Lo que publica en sus revistas y en su web. Siempre te decimos de dónde sale.</p></article><article data-reveal style="transition-delay:150ms"><h3>Lo que decide cada uno</h3><p>En algunos temas, la organización dice que es una decisión de conciencia. Pero entre lo que se dice y la presión que se siente en la congregación puede haber mucha distancia.</p></article><article data-reveal style="transition-delay:300ms"><h3>Lo que vive cada familia</h3><p>Los testimonios cuentan cómo se aplicó una norma en un caso concreto. No sirven para hacer estadísticas, pero sí para entender lo que las revistas no cuentan.</p></article></div><p class="normas-legal" data-reveal>Y una aclaración: hablamos de normas religiosas, no de leyes. Lo que dice la ley depende de cada país.</p></div></section>


    <section class="normas-articulo normas-evidencia" id="celebraciones" aria-labelledby="celebraciones-titulo"><div class="normas-ancho normas-articulo__inner"><div><p class="guia-kicker">Celebraciones</p><h2 id="celebraciones-titulo">¿Celebran cumpleaños y Navidad?</h2><p data-reveal>No. Los Testigos de Jehová <strong>no celebran los cumpleaños ni la Navidad</strong>. Tampoco muchas otras fiestas populares. Te explicamos por qué y lo que cuentan quienes crecieron sin ellas:</p><div data-reveal class="normas-enlaces-tema"><a class="guia-pill guia-pill--solid" href="/testigos-de-jehova/cumpleanos/">Por qué no celebran los cumpleaños</a><a class="guia-pill guia-pill--navy" href="/testigos-de-jehova/navidad/">Por qué no celebran la Navidad</a><a class="guia-pill guia-pill--navy" href="/testigos-de-jehova/celebraciones/">Otras fiestas</a></div></div></div></section>

    <section class="normas-articulo normas-articulo--salvia normas-capitulo normas-capitulo--pareja" id="pareja" aria-labelledby="pareja-titulo"><div class="normas-ancho normas-articulo__inner"><div><p class="guia-kicker">Noviazgo y matrimonio</p><h2 id="pareja-titulo">¿Puede un Testigo de Jehová salir con alguien de otra religión?</h2><p data-reveal><strong>La organización pide que un Testigo bautizado salga solo con otro Testigo bautizado.</strong> Su web lo dice así: «los Testigos solo debemos empezar una relación y casarnos con alguien que también sea testigo de Jehová bautizado, no con alguien que simplemente respete nuestras creencias»<sup class="ad-ref" id="ref-2"><a href="#fn-2" aria-label="Fuente 2">2</a></sup>. Lo llama «mandato». Para ellos, empezar una relación es un paso serio que debe llevar al matrimonio.</p><p data-reveal>La misma página dice que cada uno decide si quiere tener pareja y con quién, siempre dentro de esas pautas.</p><p data-reveal>Si ya estás casado y tu pareja no es Testigo, la cosa cambia: la organización aconseja no separarse por motivos religiosos<sup class="ad-ref" id="ref-3"><a href="#fn-3" aria-label="Fuente 3">3</a></sup>.</p></div></div></section>

    <section class="normas-estudios normas-evidencia" id="estudios" aria-labelledby="estudios-titulo"><div class="normas-ancho normas-estudios__inner"><div><p class="guia-kicker">Universidad y educación superior</p><h2 id="estudios-titulo">¿Pueden ir a la universidad?</h2><p data-reveal><strong class="respuesta-corta">Sí.</strong> Hoy la organización dice que es una decisión personal, y reconoce que antes no lo planteaba así. La Atalaya de mayo de 2026<sup class="ad-ref" id="ref-4"><a href="#fn-4" aria-label="Fuente 4">4</a></sup> dice: «En el pasado, nuestras publicaciones han desaconsejado ciertos tipos de estudios adicionales». Pone como ejemplo un artículo de 2005 que «hablaba de los peligros de la educación superior» y añade que «ningún cristiano —ni siquiera los ancianos— debe juzgar la decisión personal» que tome cada uno.</p><h3 data-reveal>Qué decían antes las publicaciones</h3><p data-reveal>En 1989, ¡Despertad!<sup class="ad-ref" id="ref-5"><a href="#fn-5" aria-label="Fuente 5">5</a></sup> se preguntaba si «merece siempre la pena» el tiempo y el dinero que exige un título universitario. Recomendaba a los jóvenes hacer del ministerio su carrera, aunque añadía que «sigue siendo un asunto de decisión personal».</p><p data-reveal>En 2005, La Atalaya advertía a los padres de los peligros de la educación superior<sup class="ad-ref" id="ref-6"><a href="#fn-6" aria-label="Fuente 6">6</a></sup> y animaba a los jóvenes a buscar metas religiosas. En 2014<sup class="ad-ref" id="ref-7"><a href="#fn-7" aria-label="Fuente 7">7</a></sup> preguntaba a los jóvenes: «¿Seguirás las metas que este mundo te ofrece? ¿O irás por el camino que te llevará a servir más a Jehová?», e incluía un recuadro titulado «Beneficios que la universidad no puede aportarte».</p><p data-reveal>Nunca fue una prohibición formal, pero hoy la propia organización reconoce que sus publicaciones lo desaconsejaban.</p></div><figure class="normas-media layered-media" data-reveal><img src="/uploads/2026/10/tdj-normas-universidad-1536.webp" srcset="/uploads/2026/10/tdj-normas-universidad-900.webp 900w, /uploads/2026/10/tdj-normas-universidad-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 520px" alt="Ilustración de una estudiante entrando en un aula universitaria con un hilo lima que avanza hacia el espacio abierto." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span></figure></div></section>

    <section class="normas-articulo normas-evidencia normas-capitulo normas-capitulo--politica" id="politica" aria-labelledby="politica-titulo"><div class="normas-ancho normas-articulo__inner"><div><p class="guia-kicker">Voto y neutralidad política</p><h2 id="politica-titulo">¿Pueden votar los Testigos de Jehová?</h2><p data-reveal>No hay ninguna norma oficial que les prohíba votar. <strong>Lo que pide la organización es neutralidad política, y en la práctica muchos Testigos no votan.</strong> Su web<sup class="ad-ref" id="ref-8"><a href="#fn-8" aria-label="Fuente 8">8</a></sup> dice que no apoyan a ningún partido ni candidato, que no se presentan a cargos públicos y que «tampoco interferimos si alguien decide votar».</p><figure class="normas-media normas-media--soft layered-media normas-politica__figura" data-reveal><img src="/uploads/2026/10/tdj-normas-voto-urna-hilo-1536.webp" srcset="/uploads/2026/10/tdj-normas-voto-urna-hilo-900.webp 900w, /uploads/2026/10/tdj-normas-voto-urna-hilo-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 520px" alt="Ilustración de una persona depositando una papeleta en blanco en una urna; un hilo verde la conecta con su mano." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span></figure><h3 data-reveal>¿Por qué muchos no votan?</h3><p data-reveal>Dan varias razones: que los cristianos no son «parte del mundo», que son embajadores del Reino de Dios, que si votas a alguien te haces responsable de lo que haga, que la política divide a las congregaciones y que, si son neutrales, pueden predicar a cualquiera.</p><p data-reveal>Antes el planteamiento era más tajante. En 1964, La Atalaya<sup class="ad-ref" id="ref-9"><a href="#fn-9" aria-label="Fuente 9">9</a></sup> decía: «En ningún país participan en la política los testigos de Jehová. No son de este mundo. Por lo tanto, no participan en votar en las elecciones». Donde votar era obligatorio, explicaba que podían ir a las urnas y anular la papeleta.</p><p data-reveal>En 1999 cambió el planteamiento. La Atalaya decía<sup class="ad-ref" id="ref-10"><a href="#fn-10" aria-label="Fuente 10">10</a></sup> que no veía nada en la Biblia contra votar en sí y que «cada Testigo es responsable de tomar una decisión en conciencia y basada en la Biblia».</p><h3 data-reveal>¿Qué pasa si votan?</h3><p data-reveal>Ninguna norma escrita dice que votar sea motivo de expulsión. Pero algunos exmiembros cuentan otra cosa. Uno de los testimonios mejor documentados es una presentación escrita ante un comité del Parlamento australiano (Submission 53)<sup class="ad-ref" id="ref-11"><a href="#fn-11" aria-label="Fuente 11">11</a></sup>, que afirma que votar puede acabar en expulsión y rechazo social. Es el testimonio de quien la presentó, no una conclusión del comité.</p><h3 data-reveal>¿Y en España?</h3><p data-reveal>En España votar no es obligatorio, así que el problema no se plantea igual. En los países donde sí lo es, La Atalaya de 1999 decía que cada Testigo decide en conciencia y que «lo que haga una vez allí queda entre él y su Creador».</p><h3 data-reveal>¿Y la bandera, el himno y la guerra?</h3><p data-reveal>La neutralidad también se nota en que no saludan a la bandera ni cantan el himno<sup class="ad-ref" id="ref-12"><a href="#fn-12" aria-label="Fuente 12">12</a></sup> y en que no van a la guerra<sup class="ad-ref" id="ref-13"><a href="#fn-13" aria-label="Fuente 13">13</a></sup>. Lo del servicio militar y sus alternativas depende de las leyes de cada país.</p></div></div></section>

    <section class="normas-articulo normas-articulo--salvia normas-vida" id="vida-cotidiana" aria-labelledby="cotidiana-titulo"><div class="normas-ancho normas-vida__inner"><div><p class="guia-kicker">Consumo y salud</p><h2 id="cotidiana-titulo">Alcohol y tabaco: dos pautas distintas</h2><h3 data-reveal>¿Pueden beber alcohol?</h3><p data-reveal>Sí. La organización permite beber con moderación<sup class="ad-ref" id="ref-14"><a href="#fn-14" aria-label="Fuente 14">14</a></sup>, pero considera pecado emborracharse.</p><h3 data-reveal>¿Pueden fumar o consumir tabaco?</h3><p data-reveal>No. La organización reconoce que la Biblia no habla del tabaco<sup class="ad-ref" id="ref-15"><a href="#fn-15" aria-label="Fuente 15">15</a></sup>, pero concluye que fumar es pecado porque va contra principios sobre la limpieza, la salud y el cuidado de los demás. Aplica lo mismo al tabaco de mascar, al rapé y a los cigarrillos electrónicos con nicotina.</p><p data-reveal>No siempre fue así. La Atalaya del 15 de octubre de 1973<sup class="ad-ref" id="ref-16"><a href="#fn-16" aria-label="Fuente 16">16</a></sup> planteó «la cuestión de ser consistentes tocante a aceptar para el bautismo a las personas que todavía usan el tabaco». A quienes ya estaban bautizados y seguían fumando se les podía dar «un período razonable, como el de seis meses», y si no lo dejaban, «deben ser removidas de la congregación». La misma revista reconocía que «la congregación les dio a entender que su práctica no se los “impedía”».</p></div><aside class="normas-articulo__nota" data-reveal><strong>Beber no es lo mismo que fumar</strong><p data-reveal>El alcohol está permitido con moderación. El tabaco, en cambio, no se permite de ninguna forma.</p></aside></div><div class="normas-ancho normas-vida__ilustraciones"><figure class="normas-media layered-media" data-reveal><img src="/uploads/2026/10/tdj-normas-alcohol-copa-hilo-1536.webp" srcset="/uploads/2026/10/tdj-normas-alcohol-copa-hilo-900.webp 900w, /uploads/2026/10/tdj-normas-alcohol-copa-hilo-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 46vw" alt="Ilustración de una copa con una pequeña cantidad de bebida junto a una botella cerrada; un hilo verde rodea la base de la copa." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span><figcaption>Se permite beber con moderación.</figcaption></figure><figure class="normas-media normas-media--round layered-media" data-reveal style="transition-delay:150ms"><img src="/uploads/2026/10/tdj-normas-tabaco-vape-hilo-1536.webp" srcset="/uploads/2026/10/tdj-normas-tabaco-vape-hilo-900.webp 900w, /uploads/2026/10/tdj-normas-tabaco-vape-hilo-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 46vw" alt="Ilustración de un cigarrillo sin encender y un vapeador; el hilo verde se detiene antes de llegar a ellos." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span><figcaption>No se permite fumar.</figcaption></figure></div></section>

    <section class="normas-ocio normas-ocio--baile" id="entretenimiento" aria-labelledby="entretenimiento-titulo"><div class="normas-ancho normas-ocio__inner"><figure class="normas-media normas-media--soft layered-media" data-reveal><img src="/uploads/2026/10/tdj-normas-baile-1536.webp" srcset="/uploads/2026/10/tdj-normas-baile-900.webp 900w, /uploads/2026/10/tdj-normas-baile-1536.webp 1536w" sizes="(max-width: 767px) 100vw, 520px" alt="Ilustración de tres personas adultas bailando en una reunión social, unidas visualmente por un hilo lima." width="1536" height="1024" loading="lazy" decoding="async" /><span aria-hidden="true"></span></figure><div><p class="guia-kicker">Ocio y vida social</p><h2 id="entretenimiento-titulo">Baile y entretenimiento</h2><h3 data-reveal>¿Está prohibido bailar?</h3><p data-reveal>No. No hay ninguna prohibición general del baile. Que un baile concreto se vea bien o mal depende del ambiente y del criterio de cada uno.</p><h3 data-reveal>¿Pueden escuchar música o ver películas?</h3><p data-reveal>Sí. La organización dice que no tiene una lista de películas, canciones o libros prohibidos<sup class="ad-ref" id="ref-17"><a href="#fn-17" aria-label="Fuente 17">17</a></sup>. Lo que hace es publicar principios para que cada uno elija.</p></div></div></section>

    <section class="normas-articulo normas-articulo--salvia" id="otras-pautas" aria-labelledby="otras-titulo"><div class="normas-ancho"><p class="guia-kicker">Otras prácticas relevantes</p><h2 id="otras-titulo">Predicación, ropa y decisiones médicas</h2><div class="normas-variacion__grid"><article data-reveal style="transition-delay:0ms"><h3>Predicación</h3><p>Para la organización, predicar es una parte central de su fe y de la educación de los hijos.<sup class="ad-ref" id="ref-18"><a href="#fn-18" aria-label="Fuente 18">18</a></sup></p></article><article data-reveal style="transition-delay:150ms"><h3>Ropa y aspecto</h3><p>Hay pautas para vestir en las reuniones y en la predicación, pero algunas cambiaron en 2023 y 2024<sup class="ad-ref" id="ref-19"><a href="#fn-19" aria-label="Fuente 19">19</a></sup>. Hoy ya no es verdad que ningún hombre pueda llevar barba ni que ninguna mujer pueda llevar pantalón. <a href="/testigos-de-jehova/vestimenta/">Ver la página sobre vestimenta</a></p></article><article data-reveal style="transition-delay:300ms"><h3>Sangre</h3><p>La postura sobre la sangre ha cambiado mucho con los años, la última vez en septiembre de 2026. Lo contamos en detalle en <a href="/testigos-de-jehova/sangre/">la página sobre sangre y transfusiones</a>.</p></article></div><div data-reveal class="normas-enlaces-tema normas-sangre-cta"><a class="guia-pill guia-pill--solid" href="/testigos-de-jehova/sangre/">Ampliar información sobre sangre y transfusiones</a></div></div></section>

    <section class="normas-faq" id="preguntas" aria-labelledby="preguntas-titulo"><div class="normas-ancho"><p class="guia-kicker">Dudas habituales</p><h2 id="preguntas-titulo">Preguntas frecuentes</h2><div class="normas-faq__lista">{preguntasFrecuentes.map(({ q, a }) => <details data-reveal><summary>{q}<span aria-hidden="true">＋</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="guia-cierre normas-mirada" id="criterio" aria-labelledby="criterio-titulo"><div class="guia-cierre__inner"><p class="guia-kicker guia-kicker--crema" data-reveal>La mirada de la AEVTJ</p><h2 id="criterio-titulo" data-reveal>Respetar la fe y escuchar a las personas</h2><p data-reveal>Respetamos que cada persona viva su fe como quiera. Lo que nos preocupa es cuando una norma deja de ser una decisión libre: cuando alguien no se atreve a votar, a estudiar o a ir a un cumpleaños por miedo a lo que pensará su congregación.</p><p data-reveal>Muchas de estas normas han cambiado, y quien vivió las versiones anteriores lo recuerda bien. La persona que dejó la universidad porque las revistas la desaconsejaban y hoy lee que es «una decisión personal». Quien fumaba y en 1973 tuvo seis meses para dejarlo o salir de la congregación. Quien no votó durante años porque se daba por hecho que un Testigo no vota.</p><p data-reveal>Es normal sentir rabia, tristeza o desconcierto al ver que algo que te costó tanto hoy se presenta como una elección de cada uno. También es normal no saber qué pensar. Lo que viviste cuenta.</p><p data-reveal>Si te presionaron o te sancionaron por alguna de estas normas, aquí hay personas que lo entienden porque pasaron por lo mismo. Cuando quieras hablar de ello, puedes <a href="/contacto/">escribirnos</a>.</p><p class="guia-kicker guia-kicker--crema sg-sigue" data-reveal>Sigue leyendo</p><div class="guia-recursos guia-recursos--ilustrados">{enlacesFinales.map((r) => <TarjetaRelacionado {...r} />)}</div><div class="guia-cierre__actions" data-reveal><a class="guia-pill guia-pill--solid" href="/contacto/">Contacta con la asociación</a><a class="guia-pill guia-pill--ghost" href="/recursos-de-ayuda/">Recursos de ayuda</a></div></div></section>

