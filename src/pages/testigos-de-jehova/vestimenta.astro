---

<ArticuloDocumental
  datos={datos}
  slug="vestimenta"
  miga="Vestimenta"
  tituloSeo="¿Cómo se visten los Testigos de Jehová? Ropa y normas"
  descripcion="Cómo visten los Testigos de Jehová, qué ha cambiado con la barba, los pantalones y la corbata, y qué pasaba antes con quien no seguía la norma."
  revisado="18 de octubre de 2026"
  revisadoIso="2026-10-18"
  referencias
  titulosFuentes={titulosFuentes}
  notasFuentes={notasFuentes}
  cortos={cortos}
  ilustraciones={ilustraciones}
  hero={{
    src: "/uploads/2026/10/tdj-vestimenta-asamblea-hero-1536.webp",
    srcset: "/uploads/2026/10/tdj-vestimenta-asamblea-hero-900.webp 900w, /uploads/2026/10/tdj-vestimenta-asamblea-hero-1536.webp 1536w",
    alt: "Asistentes sentados de espaldas en una asamblea de los Testigos de Jehová, con traje, chaqueta y vestidos, mirando hacia el escenario.",
  }}
  mostrarAccionesHero={false}
  mostrarIntroIndice={false}
  noindex
  sigueLeyendo={sigueLeyendo}
/>
