---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleContent from "../components/ArticleContent.astro";

const heroPhotos: Record<string, string> = {
  legal: "/uploads/2025/10/nmcr_downloaded_image.png",
  "guia-para-salir-de-los-testigos-de-jehova": "/uploads/2025/10/val-vesa-02dGWFjSZPo-unsplash-1.jpg",
  "guia-para-proteger-tus-derechos-sanitarios-en-caso-de-interferencia-familiar":
    "/uploads/2025/10/Serene-Seascape-at-Sunset.webp",
};

// Título y descripción SEO por página (el título visible/H1 sigue siendo el del contenido).
const seo: Record<string, { title?: string; description?: string }> = {
  transparencia: {
    title: "Transparencia de la AEVTJ",
    description: "Portal de transparencia de la AEVTJ: información clara y accesible sobre la Asociación Española de Víctimas de los Testigos de Jehová.",
  },
  "aviso-legal": {
    description: "Aviso legal de la AEVTJ: datos identificativos del titular, condiciones de uso y propiedad intelectual de victimasdetestigosdejehova.org.",
  },
  "politica-de-cookies": {
    description: "Política de cookies de la AEVTJ: qué cookies usa esta web, para qué sirven y cómo aceptarlas, rechazarlas o configurarlas.",
  },
};

const heroTitles: Record<string, string> = {
  legal: "Demandas, juicios y sentencias judiciales",
  "guia-para-salir-de-los-testigos-de-jehova": "Guía para salir de los Testigos de Jehová",
  "guia-para-proteger-tus-derechos-sanitarios-en-caso-de-interferencia-familiar":
    "Guía para proteger tus derechos sanitarios",
};

export async function getStaticPaths() {
  const excludedSlugs = new Set([
    "victimas-testigos-de-jehova-ayuda-denuncia", // home, has its own index.astro
    "recursos-de-ayuda", // has its own custom page
    "noticias", // has its own listing page
    "quienes-somos", // has its own custom page
    "guia-para-salir-de-los-testigos-de-jehova", // has its own custom page
    "hazte-socio", // has its own custom page
    "contacto", // has its own custom page
    "politica-de-privacidad", // has a custom legal page with Mailchimp disclosure
    "legal", // has its own custom page
    "demandas", // versión antigua de /legal/: redirigida con 301 en .htaccess
    "colaboradores", // integrada en /quienes-somos/#colaboradores: 301 en .htaccess
    "guia-para-proteger-tus-derechos-sanitarios-en-caso-de-interferencia-familiar", // has its own custom page
  ]);
  const entries = await getCollection("pages");
  return entries
    .filter((e) => !excludedSlugs.has(e.data.slug))
    .map((e) => ({
      params: { slug: e.data.slug },
      props: { entry: e },
    }));
}

const { entry } = Astro.props;
const { title, html } = entry.data;
const heroPhoto = heroPhotos[entry.data.slug];
const heroTitle = heroTitles[entry.data.slug];

// The hero already shows the page heading, so drop the leading <h1> in the
// extracted body to avoid repeating it verbatim right below the hero.
const bodyHtml = heroPhoto ? html.replace(/<h1>.*?<\/h1>/s, "") : html;
---

<BaseLayout title={seo[entry.data.slug]?.title ?? title} description={seo[entry.data.slug]?.description} breadcrumbs={[{ label: heroTitle ?? title }]} image={heroPhoto}>
  <ArticleContent title={heroTitle ?? title} html={bodyHtml} heroPhoto={heroPhoto} />
</BaseLayout>
