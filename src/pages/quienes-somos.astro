<script>
  // --- Reveal on scroll (250ms ease-out, escalonado, reduced-motion friendly) ---
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealEls = document.querySelectorAll<HTMLElement>("[data-qs-reveal]");
  if (!reduceMotion && "IntersectionObserver" in window) {
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add("is-visible");
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
    );
    revealEls.forEach((el) => obs.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  }

  // --- Transparencia: acordeón exclusivo (un bloque abierto) ---
  const accordion = document.querySelector<HTMLElement>(".qs-accordion");
  const accItems = Array.from(document.querySelectorAll<HTMLElement>(".qs-acc-item"));

  function setItem(item: HTMLElement, open: boolean) {
    item.classList.toggle("is-open", open);
    item.querySelector<HTMLButtonElement>(".qs-acc-btn")?.setAttribute("aria-expanded", String(open));
  }

  function openExclusive(target: HTMLElement) {
    accItems.forEach((other) => setItem(other, other === target));
  }

  accItems.forEach((item) => {
    setItem(item, item.dataset.accOpen === "true");
  });

  accordion?.addEventListener("click", (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>(".qs-acc-btn");
    if (!btn) return;
    const item = btn.closest<HTMLElement>(".qs-acc-item");
    if (!item) return;
    if (item.classList.contains("is-open")) {
      setItem(item, false);
    } else {
      openExclusive(item);
    }
  });

  // --- Misión: pestañas (una tarjeta visible) ---
  const missionTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".qs-pill"));
  const missionPanels = Array.from(document.querySelectorAll<HTMLElement>(".qs-panel"));

  function restartPanelAnim(panel: HTMLElement) {
    panel.classList.remove("qs-panel-in");
    void panel.offsetWidth; // reinicia la animación al cambiar de pestaña
    panel.classList.add("qs-panel-in");
  }

  function selectMissionTab(tab: HTMLButtonElement, focus = false) {
    missionTabs.forEach((t) => {
      const selected = t === tab;
      t.setAttribute("aria-selected", String(selected));
      t.tabIndex = selected ? 0 : -1;
    });
    missionPanels.forEach((p) => {
      const show = p.id === tab.getAttribute("aria-controls");
      p.hidden = !show;
      if (show) restartPanelAnim(p);
    });
    if (focus) tab.focus();
  }

  missionTabs.forEach((tab) => {
    tab.addEventListener("click", () => selectMissionTab(tab));
  });

  document
    .querySelector('[role="tablist"][aria-label="Áreas de nuestra misión"]')
    ?.addEventListener("keydown", (ev) => {
      const e = ev as KeyboardEvent;
      const current = missionTabs.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;
      let next = -1;
      if (e.key === "ArrowRight") next = (current + 1) % missionTabs.length;
      else if (e.key === "ArrowLeft") next = (current - 1 + missionTabs.length) % missionTabs.length;
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = missionTabs.length - 1;
      if (next === -1) return;
      e.preventDefault();
      selectMissionTab(missionTabs[next], true);
    });

  // Deep-link: #mision-<id> activa directamente esa pestaña
  if (window.location.hash.startsWith("#mision-")) {
    const linked = missionTabs.find((t) => t.getAttribute("aria-controls") === window.location.hash.slice(1));
    if (linked) selectMissionTab(linked);
  }

  // Índice sticky: resaltar sección visible
  const indexLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".qs-index-link"));
  if ("IntersectionObserver" in window && indexLinks.length) {
    const idxObs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).id;
          indexLinks.forEach((l) => l.classList.toggle("is-current", l.getAttribute("href") === `#${id}`));
        }
      },
      { rootMargin: "-30% 0px -60% 0px" }
    );
    accItems.forEach((i) => idxObs.observe(i));
  }

  // Índice sticky: al clicar, abrir la sección correspondiente
  indexLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const target = accItems.find((i) => `#${i.id}` === link.getAttribute("href"));
      if (target) openExclusive(target);
      indexLinks.forEach((l) => l.classList.toggle("is-current", l === link));
    });
  });
</script>
