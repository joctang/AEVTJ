---

<BaseLayout title="Quienes somos">
  <div class="qs">
    <!-- HERO: degradado solo abajo, texto abajo a la izquierda -->
    <section class="relative overflow-hidden bg-brand-ink text-white">
      <img
        src="/uploads/2025/10/16690551373007.jpg"
        alt="Miembros de la junta directiva de la AEVTJ frente a la sede de los Testigos de Jehová en España"
        class="absolute inset-0 h-full w-full object-cover object-[center_20%]"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-brand-ink/95 via-brand-ink/35 to-transparent"
      >
      </div>
      <div class="relative mx-auto flex min-h-[70vh] max-w-[1200px] flex-col justify-end px-5 pb-24 pt-40 lg:px-8">
        <p class="qs-hero-anim qs-hero-label font-heading text-sm uppercase tracking-[0.2em] text-white/90 drop-shadow-[0_1px_4px_rgba(18,44,51,0.6)]">
          Asociación de víctimas de los Testigos de Jehová
        </p>
        <h1 class="qs-hero-anim qs-hero-title mt-3 font-heading text-5xl font-bold uppercase tracking-wide sm:text-6xl">
          Quienes somos
        </h1>
        <div class="qs-hero-anim qs-hero-sub mt-4 max-w-xl">
          <p class="text-lg text-white/90">Esta asociación está fundada por miembros como tú.</p>
          <p class="mt-1 text-lg text-white/90">Por personas que han pasado o están pasando lo mismo que tú.</p>
          <a
            href="/uploads/2026/08/ESTATUTOS_WEB.pdf"
            class="mt-6 inline-block rounded-md bg-brand-olive px-6 py-3 font-heading text-sm font-semibold uppercase tracking-wide text-white hover:bg-brand-olive-dark"
          >
            Nuestros Estatutos
          </a>
        </div>
      </div>
      <TornEdge />
    </section>

    <!-- Dos tarjetas solapadas sobre el hero -->
    <section class="mx-auto max-w-[1200px] px-5 pb-16 lg:px-8">
      <div class="qs-overlap grid gap-6 sm:grid-cols-2">
        <div class="qs-lift relative flex min-h-[220px] flex-col overflow-hidden rounded-xl border border-white/10 bg-brand-ink p-7 text-white shadow-lg">
          <span class="absolute inset-x-0 top-0 h-1.5 bg-brand-terracotta" aria-hidden="true"></span>
          <span class="font-heading text-4xl font-bold leading-none text-white/15 select-none" aria-hidden="true">01</span>
          <h3 class="mt-3 font-heading text-2xl font-semibold uppercase">Te necesitamos</h3>
          <span class="mt-2 h-0.5 w-10 bg-brand-terracotta" aria-hidden="true"></span>
          <p class="mt-3 text-sm leading-relaxed text-white/85">
            Miles de personas alrededor del mundo están sufriendo prácticas coercitivas
          </p>
          <a
            href="/hazte-socio/"
            class="mt-auto self-start pt-5 font-heading text-sm font-semibold uppercase tracking-wide text-brand-terracotta underline-offset-4 transition-colors hover:text-white hover:underline"
          >
            Hazte socio ya
            <span class="qs-arrow ml-1" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="qs-lift relative flex min-h-[220px] flex-col overflow-hidden rounded-xl border border-brand-olive/25 bg-white p-7 text-brand-ink shadow-lg">
          <span class="absolute inset-x-0 top-0 h-1.5 bg-brand-olive" aria-hidden="true"></span>
          <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="currentColor" class="mt-3 text-brand-olive" aria-hidden="true"><path d="M10 8c-3 1-5 3.5-5 7v1h5v-6H7.5C8 9 9 8.5 10 8.2V8zm9 0c-3 1-5 3.5-5 7v1h5v-6h-2.5c.5-1 1.5-1.5 2.5-1.8V8z"/></svg>
          <h3 class="mt-3 font-heading text-2xl font-semibold uppercase">Recursos</h3>
          <span class="mt-2 h-0.5 w-10 bg-brand-olive" aria-hidden="true"></span>
          <p class="mt-3 text-sm leading-relaxed text-brand-ink/75">¿Necesitas ayuda legal o psicológica?</p>
          <a
            href="/contacto/"
            class="mt-auto self-start pt-5 font-heading text-sm font-semibold uppercase tracking-wide text-brand-olive underline-offset-4 transition-colors hover:text-brand-olive-dark hover:underline"
          >
            Contacta con nosotros
            <span class="qs-arrow ml-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- MISIÓN: pestañas, una tarjeta visible -->
    <section id="mision" class="bg-brand-cream py-20">
      <div class="mx-auto max-w-[1200px] px-5 lg:px-8">
        <h2
          data-qs-reveal
          class="text-center font-heading text-3xl font-semibold tracking-wide text-brand-ink sm:text-4xl"
        >
          <span class="qs-title-marker">Nuestra misión</span>
        </h2>

        <div
          data-qs-reveal
          style="--qs-delay: 90ms"
          role="tablist"
          aria-label="Áreas de nuestra misión"
          class="mt-9 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3"
        >
          {
            mission.map((m, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${m.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`mision-${m.id}`}
                tabindex={i === 0 ? 0 : -1}
                class="qs-pill inline-flex items-center gap-2 rounded-full px-5 py-2.5 font-heading text-[13px] font-semibold uppercase tracking-wider sm:px-6 sm:text-sm"
              >
                <span class="[&_svg]:h-4 [&_svg]:w-4" aria-hidden="true" set:html={missionIcons[m.icon]} />
                {m.label}
              </button>
            ))
          }
        </div>

        <div data-qs-reveal style="--qs-delay: 180ms" class="mt-8">
          {
            mission.map((m, i) => (
              <article
