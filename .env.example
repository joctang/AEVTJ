# Identificador del contenedor de Google Tag Manager, por ejemplo GTM-XXXXXXX.
# Se carga únicamente después de aceptar las tecnologías no necesarias.
PUBLIC_GTM_ID=

# Token de verificación proporcionado por Google Search Console.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# URL de acción del formulario de registro de Mailchimp.
# Debe copiarse de la audiencia/formulario de Mailchimp; no es una API key.
PUBLIC_MAILCHIMP_FORM_ACTION=

# Página pública de Mailchimp para suscribirse a la newsletter sin hacerse socio.
PUBLIC_MAILCHIMP_NEWSLETTER_URL=https://mailchi.mp/victimasdetestigosdejehova/newsletter
